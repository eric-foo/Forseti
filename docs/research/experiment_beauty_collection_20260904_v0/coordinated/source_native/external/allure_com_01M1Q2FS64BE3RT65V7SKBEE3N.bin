n button--primary-pair product-offer__buy-button" data-event-click="{&quot;element&quot;:&quot;Button&quot;,&quot;outgoingURL&quot;:&quot;https://cna.&quot;}" data-testid="Button" id="6793ed937d004758ba16e749" type=""><span class="ButtonLabel-eCjeQX gMxkqd button__label"><span>$15</span> <p class="price-above-seller-name">Amazon</p></span></a></div></div><div class="ProductOfferWrapper-jbhYWP iiBYgp product-offer" data-testid="product-offer-wrapper"><div class="ProductOfferCtaBlock-cuZdYn bMpPDL product-offer__cta-block" id="button_label_$15OliveYoung"><a href="https://cna." rel="sponsored noopener" target="_blank" aria-labelledby="upc_67927e53c18d2a3e66739ecd button_label_$15OliveYoung" data-buy-button="true" data-offer-retailer="Olive Young" data-offer-url="https://global.oliveyoung.com/product/detail?prdtNo=GA210000169" class="BaseButton-bcGmUs ButtonWrapper-dPMEWm dXLnva rhJKg button button--primary-pair product-offer__buy-button" data-event-click="{&quot;element&quot;:&quot;Button&quot;,&quot;outgoingURL&quot;:&quot;https://cna.&quot;}" data-testid="Button" id="6793ed937d004758ba16e74a" type=""><span class="ButtonLabel-eCjeQX gMxkqd button__label"><span>$15</span> <p class="price-above-seller-name">Olive Young</p></span></a></div></div></div></div></div></div></div></div></div></div></div><div class="GridItem-bufwYC fdedvq grid--item grid-layout__aside"></div></div><div class="GridWrapper-uulHE dCnZHU grid grid-margins grid-items-2 ArticlePageChunksGrid-kSknMg dSvDdx grid-layout--adrail narrow wide-adrail" data-journey-hook="grid-wrapper"><div class="GridItem-bufwYC kKTABR grid--item grid-layout__content"><div class="BodyWrapper-cuqCAc bjOcqR body body__container article__body" data-journey-hook="client-content" data-testid="BodyWrapper"><div class="body__inner-container"><p>Lee also uses an <a href="https://www.allure.com/gallery/best-facial-essences" target="_blank" class="text link">essence</a>—which is not to be confused with a toner, which provides gentle exfoliation—for a hydration boost. “I love using the Mixsoon Bean Essence as my serum step because it offers great hydration and skin-plumping benefits,” says Lee.</p><p>When it comes to makeup, Lee keeps it simple but always reaches for the Clio Black Eyeliner. “I have been using eyeliners from Clio for years as it’s the number one black eyeliner in Korea,’ says Lee. This water-proof pencil has a two millimeter-thin tip that makes creating sharp precise liner look effortless.</p><h2><strong>Yanghee Paik, co-founder of Rael Beauty</strong></h2><p>Running an international skin- and feminine- care brand is no easy feat, but <a data-offer-url="https://www.instagram.com/yanghee_paik/?hl=en" class="external-link text link" data-event-click="{&quot;element&quot;:&quot;ExternalLink&quot;,&quot;outgoingURL&quot;:&quot;https://www.instagram.com/yanghee_paik/?hl=en&quot;}" href="https://www.instagram.com/yanghee_paik/?hl=en" rel="nofollow noopener" target="_blank">Yanghee Paik</a> always looks fresh while doing it thanks to a curated collection of K-beauty products.</p><div class="GridWrapper-uulHE cCvYrT grid grid-even grid-items-2 GroupCalloutWrapper-dilQaj fWWfCZ callout callout--group callout--group-2 product-group" data-journey-hook="grid-wrapper"><div class="GridItem-bufwYC dmHJJo grid--item"><div class="UnifiedProductCardBody-fMbTZU jQTyKU product-embed" data-item="{&quot;ctaHref&quot;:&quot;https://cna.&quot;,&quot;dangerousDek&quot;:&quot;&quot;,&quot;productBrand&quot;:&quot;Rael Beauty&quot;,&quot;dangerousHed&quot;:&quot;Miracle Clear Exfoliating Cleanser&quot;,&quot;embedSize&quot;:null,&quot;isFirstProduct&quot;:false,&quot;isSponsored&quot;:false,&quot;offerRetailer&quot;:&quot;Amazon&quot;,&quot;offerUrl&quot;:&quot;https://www.amazon.com/Rael-Miracle-Clear-Exfoliating-Cleanser/dp/B09KG8B2QK?&quot;,&quot;contentType&quot;:&quot;product&quot;,&quot;productId&quot;:&quot;67928e0c8c12748e63f29f1f&quot;,&quot;showOfferUrl&quot;:false,&quot;showPriceOnButton&quot;:true,&quot;showAffiliateDisclaimerOnFirstProduct&quot;:false,&quot;enableAffiliateDisclaimerLabel&quot;:false,&quot;dangerousCredit&quot;:null,&quot;showLocalisedOffers&quot;:false,&quot;hasCheckPriceFeature&quot;:false,&quot;isUpcEnabled&quot;:true,&quot;showClampedProductDescription&quot;:true,&quot;productDescriptionLineLength&quot;:2,&quot;hasReadMoreFeature&quot;:false,&quot;index&quot;:10,&quot;hasAffiliateLinkDisabled&quot;:false,&quot;isMobileView&quot;:false,&quot;showMultipleImageCount&quot;:4,&quot;hasProsConsFeature&quot;:false,&quot;hasRatingFeature&quot;:false,&quot;pros&quot;:[],&quot;cons&quot;:[],&quot;rating&quot;:&quot;&quot;,&quot;shouldUseAmazonPrimeDayLiveAPIData&quot;:true,&quot;contentInfo&quot;:{&quot;contentUrl&quot;:&quot;https://www.allure.com/story/korean-beauty-founders-favorite-products&quot;,&quot;contentName&quot;:&quot;7 K-Beauty Founders Share Their Beauty MVPs&quot;},&quot;enableGtmFixesIntersectionObserver&quot;:true,&quot;enableGtmFixesUseRef&quot;:true,&quot;textBadge&quot;:null,&quot;seal&quot;:null,&quot;id&quot;:&quot;67928e0c8c12748e63f29f1f&quot;,&quot;brand&quot;:{&quot;name&quot;:&quot;Rael Beauty&quot;},&quot;offers&quot;:[{&quot;offerUrl&quot;:&quot;https://www.amazon.com/Rael-Miracle-Clear-Exfoliating-Cleanser/dp/B09KG8B2QK?&quot;,&quot;price&quot;:&quot;$13&quot;,&quot;currency&quot;:&quot;USD&quot;,&quot;purchaseUri&quot;:&quot;https://cna.&quot;,&quot;sellerName&quot;:&quot;Amazon&quot;,&quot;countryCode&quot;:&quot;US&quot;,&quot;offerId&quot;:&quot;6793edb69c87c2bbec12242d&quot;,&quot;reducedPrice&quot;:&quot;&quot;}],&quot;component&quot;:&quot;unified_product_card&quot;,&quot;total_index&quot;:1,&quot;hasMultipleImage&quot;:false,&quot;showProsConsData&quot;:false,&quot;videoIds&quot;:[],&quot;offersLength&quot;:1,&quot;hasBookmarkingFeature&quot;:true,&quot;isBookmarked&quot;:false,&quot;isBookmarkStatusReady&quot;:false}"><div id="67928e0c8c12748e63f29f1f" type="embed" class="UnifiedProductCardWrapper-eMpakX 
av\",\"children\":[[\"$\",\"span\",null,{\"className\":\"on-page-sub-nav__label\",\"children\":\"Seal of Acceptance Product Directory\"}],[\"$\",\"ul\",null,{\"className\":\"on-page-sub-nav__list custom-scrollbar\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3241\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Cleanser\"}]}],[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3229\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Disposable Wipes\"}]}],[\"$\",\"li\",\"2\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3276\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Hair Product\"}]}],[\"$\",\"li\",\"3\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3304\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Laundry\"}]}],[\"$\",\"li\",\"4\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3231\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Moisturizer\"}]}],[\"$\",\"li\",\"5\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3236\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Over the counter drugs\"}]}],[\"$\",\"li\",\"6\",{\"children\":[\"$\",\"$L16\",null,{\"href\":\"/eczema-products?product_category=3259\",\"prefetch\":true,\"className\":\"on-page-sub-nav__link\",\"children\":\"Sunscreen\"}]}]]}]]}]}],[\"$\",\"$L39\",null,{\"breadcrumbs\":[{\"text\":\"Home\",\"url\":\"/\"},{\"text\":\"Products\",\"url\":\"/eczema-products/\"},{\"text\":\"Super Saturated\",\"url\":null}]}],[\"$\",\"$L3a\",null,{\"productHeroCoreData\":{\"productDescription\":\"At higher percentages glycerin goes beyond hydration to unlock its unique barrier replenishing and soothing properties. This one-of-a-kind saturating blue goo also has multi-molecular weight humectants like polyglutamic acid, and super soothers like bisabolol, prickly pear extract, and niacinamide to keep irritation at bay. Super Saturated is clinically proven to increase skin's resilience and natural hydration overtime. \\n\\nAs your main serum: On clean, damp skin, apply 1-2 pumps. Follow with your favorite moisturizer or oil to lock in the hydration. You can use Super Saturated AM \u0026 PM\\n\\nAs a humectant booster: Add humectant goodness with 1 pump of Super Saturated in your favorite hydrating serums for boosted barrier support and hydration\",\"productAcceptedDate\":\"2026-07-13T00:00:00+00:00\",\"productWebsiteLink\":\"https://experimentbeauty.com/products/super-saturated\",\"googleSearchLink\":\"https://www.google.com/search?q=Super%20Saturated\",\"badges\":null,\"brand\":\"Experiment Beauty\",\"accordionData\":[{\"heading\":\"Ingredients\",\"description\":\"\u003cp\u003eAllantoin, Bisabolol, Diglycerin, Disodium Edta, Ethylparaben, Glycerin, Malachite Extract, Methylparaben, Niacinamide, Opuntia Ficus-Indica Stem Extract, Phenoxyethanol, Polyacrylate Crosspolymer-6, Polyglutamic Acid, Propanediol, Propylene Glycol, Sodium Polyacrylate, Squalane, Tocopherol, Water, Zingiber Officinale (Ginger) Root Extract\u003c/p\u003e\"},{\"heading\":\"About the Seal\",\"description\":\"\u003cp\u003eIndividuals with eczema and/or sensitive skin have the responsibility for identifying ingredients in any product that could potentially irritate their skin and/or trigger potential allergies. Healthcare related questions should be referred to a physician or other healthcare provider, including questions regarding product ingredients, as well as whether use of the accepted product(s) is suitable. See the Seal of Acceptance™ product directory for additional program information.\u003c/p\u003e\\n\"},{\"heading\":\"Disclaimer\",\"description\":\"\u003cp\u003eThe directory contains a listing of products which have received the Seal of Acceptance™. \u003ca href=\\\"https://nationaleczema.org/eczema-products/seal-home\\\"\u003eLearn more about the Seal.\u003c/a\u003e\u003c/p\u003e\\n\"}],\"productHaveMultipleShades\":false},\"variants\":[{\"productId\":49991,\"title\":\"Super Saturated\",\"productImageLarge\":{\"node\":{\"altText\":\"\",\"mediaDetails\":{\"height\":477,\"width\":400,\"sizes\":[{\"name\":\"medium\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-335x400.png\"},{\"name\":\"thumbnail\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-150x150.png\"},{\"name\":\"sponsor-card-size\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-290x200.png\"},{\"name\":\"sponsor_content\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-290x268.png\"},{\"name\":\"four_col_vertical\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-290x235.png\"},{\"name\":\"four_col_plus_vertical\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-305x235.png\"},{\"name\":\"three_col_vertical\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-335x235.png\"},{\"name\":\"two_col_vertical\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-400x235.png\"},{\"name\":\"beside_text_image\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-400x456.png\"},{\"name\":\"related_contents_3p\",\"sourceUrl\":\"https://cms.nationaleczema.org/wp-content/uploads/2026/07/Super-Saturated-Product-Hero-Image-400x215.png\"},{\"name\":\"related_contents_4p\",\"sourceUrl\":
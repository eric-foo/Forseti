#membership-banner-1 .flcw-membership-banner-join-now-btn {
background-color: var(--flcw-membership2-skinnybanner-btn-join-bg, var(--flcw-membership-skinnybannerExloration-T2-join-now-btn-bg-color, white));
color: var(--flcw-membership2-skinnybanner-btn-join-text, var(--flcw-membership-skinnybannerExloration-T2-join-now-btn-text-color, var(--flexi-brand-color-1)));

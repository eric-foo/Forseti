--flw-sm-text-transform-var-list-item-byline: uppercase;
--flw-display-var-list-item-byline: block;
--flw-sm-display-var-list-item-byline: block;
--flw-font-family-var-item-byline: var(--font-family-2);
--flw-color-var-item-byline: #1b1b1b;
/* search result list item title font-size, font-family, line-height, color & text-transform dtp & mobile */
--flw-size-var-search-result-list-item-title: 24px;
--flw-sm-size-var-search-result-list-item-title: 16px;
--flw-line-height-var-search-result-list-item-title: 30px;
--flw-sm-line-height-var-search-result-list-item-title: 22px;
--flw-text-transform-var-search-result-list-item-title: none;
--flw-sm-text-transform-var-search-result-list-item-title: none;

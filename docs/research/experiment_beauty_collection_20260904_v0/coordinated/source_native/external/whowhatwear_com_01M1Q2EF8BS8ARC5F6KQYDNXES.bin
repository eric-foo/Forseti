--flw-sm-flex-var-listing-item: 0 0 calc((100%/var(--flw-sm-number-var-listing-col)) - ((var(--flw-sm-gap-x-var-listing-list) - (var(--flw-sm-gap-x-var-listing-list)/var(--flw-sm-number-var-listing-col)))));

/* search result list item byline font-size, font-family, line-height, color dtp & mobile */
--flw-size-var-search-result-list-item-byline: 11px;
--flw-sm-size-var-search-result-list-item-byline: 11px;
--flw-line-height-var-search-result-list-item-byline: 16px;

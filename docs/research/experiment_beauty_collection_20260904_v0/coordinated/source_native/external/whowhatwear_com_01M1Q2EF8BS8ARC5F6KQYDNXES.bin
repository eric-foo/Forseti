ejectedAllConsent') === 'true') {\n console.log(\"userRejectedAllConsent removeItem\");\n localStorage.removeItem('kiosq_article_url_ack');\n } *\/\n return localStorage.getItem('userRejectedAllConsent') === 'true';\n}","label":"Rejected all cookies","priority":10},{"name":"TestCampaign","script":"() => {\n const urlParams = new URLSearchParams(window.location.search);\n const campaignToTest = urlParams.get('_flexi_test_campaign');\n return campaignToTest || '';\n}","label":"Test Campaign","priority":10},{"name":"ForceBarrierWithArticlesSeens(notForQueryBuilder)","script":"() => {\n const urlParams = new URLSearchParams(window.location.search);\n const nbArticlesSeensExpected = parseInt(\n urlParams.get('_flexi_force_barrier_seen'),\n 10\n ); \/\/ Conversion en entier\n\n if (nbArticlesSeensExpected) {\n let decodedArticleSeenUrls = [];\n\n \/\/ V\u00e9rification que nbArticlesSeensExpected est un nombre valide\n if (!isNaN(nbArticlesSeensExpected) && nbArticlesSeensExpected > 0) {\n for (let i = 0; i < nbArticlesSeensExpected; i++) {\n decodedArticleSeenUrls.push(`\/toto\/toto${i}`);\n }\n }\n\n \/\/ V\u00e9rifiez que articleSeenUrls est d\u00e9fini avant de le d\u00e9coder\n if (typeof articleSeenUrls !== 'undefined') {\n decodedArticleSeenUrls = JSON.parse(window.atob(articleSeenUrls));\n }\n\n localStorage.removeItem('kiosq_article_url_ack');\n localStorage.setItem(\n 'kiosq_article_url_ack',\n window.btoa(JSON.stringify(decodedArticleSeenUrls))\n );\n }\n}","label":"Force barrier with articles seens (not for query builder)"},{"name":"ForceUndisplayBarrier(notForQueryBuilder)","script":"() => {\n const unDisplayBarrier = () => {\n const urlParams = new URLSearchParams(window.location.search);\n const isUnDisplayBarrier = urlParams.get('_flexi_undisplay_barrier');\n\n if (isUnDisplayBarrier) {\n const articleBody = document.getElementById('article-body');\n if (articleBody) {\n articleBody.classList.remove(\"paywall-locker\");\n }\n\n const paywallJS = document.getElementById('kiosq-app-paywall-js');\n if (paywallJS) {\n paywallJS.style.display = \"none\";\n }\n }\n };\n\n setTimeout(unDisplayBarrier, 5000);\n}","label":"Force undisplay Barrier (not for query builder)"},{"name":"UTMCampaignPaid","label":"UTM Campaign paid","script":"() => {\n const urlParams = new URLSearchParams(window.location.search);\n return (urlParams.get('utm_campaign') ?? '').toLowerCase().includes('paid');\n}","priority":10},{"label":"UTM Params","name":"UTMParams","script":"() => {\n \/\/ Get the search params\n const params = new URLSearchParams(window.location.search);\n\n \/\/ Create an object to store UTM parameters\n const utmParams = [];\n\n \/\/ UTM parameter names\n const utmNames = [\n 'utm_source',\n 'utm_source_id',\n 'utm_medium',\n 'utm_campaign',\n 'utm_term',\n 'utm_content'\n ];\n\n \/\/ Extract UTM parameters\n utmNames.forEach(name => {\n const value = params.get(name);\n if (value) {\n utmParams.push(value);\n }\n });\n\n return utmParams.join(',');\n}","priority":10},{"name":"FreeRemainingArticleAfterLogin","label":"Free remaining article after login","script":"() => {\n if (localStorage.getItem(\"kiosq_article_url_ack\") !== null) {\n const articleSeenUrls = localStorage.getItem(\"kiosq_article_url_ack\");\n const decodedArticleSeenUrls = JSON.parse(window.atob(articleSeenUrls));\n const limitFreeArticlesAfterLogin = window.FUTR.Kiosq?.defaultSiteConfig?.limitOfFreeArticleAfterLogin || 0;\n const numberOfFreeArticleRemaining = limitFreeArticlesAfterLogin-decodedArticleSeenUrls.length;\n return numberOfFreeArticleRemaining >= 0 ? numberOfFreeArticleRemaining : 0;\n }\n\n return 0;\n }","priority":10},{"script":"() => {\n \/\/ Get the search params\n const params = new URLSearchParams(window.location.search);\n\n \/\/ Create an object to store UTM parameters\n const utmParams = [];\n\n \/\/ UTM parameter names\n const utmNames = [\n 'channel'\n ];\n\n \/\/ Extract UTM parameters\n utmNames.forEach(name => {\n const value = params.get(name);\n if (value) {\n utmParams.push(value);\n }\n });\n\n return utmParams.join(',');\n}","label":"Subscription Channel","name":"SubscriptionChannel","priority":10},{"name":"GetQueryStringKeys","label":"GetQueryStringKeys","script":"() => {\n \/\/ Get the search params\n const params = new URLSearchParams(window.location.search);\n\n \/\/ Create an array of 'key=value' strings (or just 'key' when value is empty)\n const paramStrings = [];\n\n \/\/ Iterate through all parameters and create the strings\n params.forEach((value, key) => {\n paramStrings.push(value === '' ? key : `${key}=${value}`);\n });\n\n return paramStrings;\n}","priority":10},{"name":"UrlPath","script":"() => {return window.location.pathname;}","label":"Url Path","priority":10},{"name":"ABTestCampaigns","label":"AB test campaigns","script":"() => {\n let result = '';\n const str = window.VAN?.abTest?.variationId || '';\n\n if (str) {\n const parts = str.split('|');\n\n const variantId = parts[2];\n const variantNumber = parts[3];\n result = `${variantId}_${variantNumber}`;\n }\n\n return result;\n}","priority":9},{"name":"GetSiteID","script":"() => {return window.ffte.site+\"_\"+window.ffte.lang || '';}","label":"GetSiteID","priority":10},{"name":"StorageUserCountry","label":"StorageUserCountry","script":"() => {\n return localStorage.getItem('btUserCountry') || \"\";\n}","priority":10}];
window.FUTR.Campaigns.Context = window.FUTR.Campaigns.Context.map(function({script, ...item}) {
try {
return {
...item,
computeValue:(eval(script))(),
};
} catch (e) {
if (e instanceof SyntaxError) {
console.error(
"%c Pythia FLEXI campaigns ", "background: #008f11;color: #ffffff;",
`Flexi Setting Script Campaign ${item.name} has syntax error: ` + e.message
);
} else {
console.log(
"%c Pythia FLEXI campaigns ", "background: #008f11;color: #ffffff;",
`Flexi Setting Script Campaign ${item.name} has`,e.message
)
}
}
})
window.FUTR.Campaigns.Flexi = window.FUTR.Campaigns.Flexi || {
application: 'flexi',
pythiaEndpoint: 'https://cache.pythia.futureplc.com',
enabled: '1',
matchAll: [],
};
</script>

    <script defer src="https://unpkg.com/lucide@0.292.0/dist/umd/lucide.min.js"></script>
    <script>
      function twInitIcons(){ if (window.lucide) window.lucide.createIcons(); }
      document.addEventListener('turbolinks:load', twInitIcons);
      document.addEventListener('DOMContentLoaded', twInitIcons);
      // 2026 mobile overlays (delegated -> survives Turbolinks): left drawer + account sheet.
      function twOverlay(sel, scrimSel, trigSel, open){
        var d=document.querySelector(sel), s=document.querySelector(scrimSel);
        if(!d||!s) return;
        d.classList.toggle('open', open); s.classList.toggle('open', open);
        var t=document.querySelectorAll(trigSel);
        for(var i=0;i<t.length;i++) t[i].setAttribute('aria-expanded', open?'true':'false');
        document.body.style.overflow = open ? 'hidden' : '';
      }
      function twDrawer(open){ twOverlay('.drawer','.drawer-scrim','[data-drawer-open]', open); }
      function twSheet(open){ twOverlay('.msheet','.msheet-scrim','[data-sheet-open]', open); }
      // Mobile filter sheet (#filters slides up). Same overlay contract as the drawer.
      function twFilters(open){ twOverlay('#filters','.filters-scrim','[data-filters-open]', open); }
      document.addEventListener('click', function(e){
        if (e.target.closest('[data-drawer-open]')) { e.preventDefault(); twDrawer(true); }
        else if (e.target.closest('[data-drawer-close]')) { e.preventDefault(); twDrawer(false); }
        else if (e.target.closest('[data-sheet-open]')) { e.preventDefault(); twSheet(true); }
        else if (e.target.closest('[data-sheet-close]')) { e.preventDefault(); twSheet(false); }
        else if (e.target.closest('[data-filters-open]')) { e.preventDefault(); twFilters(true); }
        else if (e.target.closest('[data-filters-apply]')) {
          // The sheet's primary CTA used to only close. Checkbox filters are STAGED —
          // they arm a mid-scroll "apply" link and are lost on a bare close. Follow
          // whichever staged link is armed (loses .btn-disabled on first change),
          // otherwise just close.
          e.preventDefault();
          var armed = document.querySelector('#filter-ingredients:not(.btn-disabled), #ingr-filter:not(.btn-disabled)');
          var href = armed && armed.getAttribute('href');
          twFilters(false);
          if (href) {
            if (window.Turbolinks && Turbolinks.visit) { Turbolinks.visit(href); } else { window.location.href = href; }
          }
        }
        else if (e.target.closest('[data-filters-close]')) { e.preventDefault(); twFilters(false); }
      });
      document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ twDrawer(false); twSheet(false); twFilters(false); } });
      // v2: hide-on-scroll for the floating desktop header island
      (function(){
        var TOP=70, HIDE=56, REVEAL=90, last=(window.scrollY||0), acc=0, isHidden=false;
        function onScroll(){
          var w=document.querySelector('.header-island-wrap'); if(!w) return;
          var y=window.scrollY||0, d=y-last; last=y;
          if(Math.abs(d)<1) return;
          if(y<TOP){ acc=0; if(isHidden){isHidden=false; w.classList.remove('is-hidden');} return; }
          if((d>0)!==(acc>0)) acc=0;
          acc+=d;
          if(!isHidden && acc>HIDE){ isHidden=true; w.classList.add('is-hidden'); acc=0; }
          else if(isHidden && acc<-REVEAL){ isHidden=false; w.classList.remove('is-hidden'); acc=0; }
        }
        document.addEventListener('scroll', onScroll, { passive:true });
      })();
    </script>

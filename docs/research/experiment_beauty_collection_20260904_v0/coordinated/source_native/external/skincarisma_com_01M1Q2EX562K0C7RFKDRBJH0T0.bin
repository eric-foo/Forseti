      <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is it fungal-acne (Malassezia) safe?","acceptedAnswer":{"@type":"Answer","text":"No — the formula contains at least one ingredient that can feed Malassezia. The flagged entries are marked in the ingredient table above."}},{"@type":"Question","name":"Can I use it during pregnancy?","acceptedAnswer":{"@type":"Answer","text":"No commonly flagged ingredient classes (retinoids, high-dose salicylic acid, hydroquinone) were found. Still, check with your doctor — this is not medical advice."}},{"@type":"Question","name":"Does it contain drying alcohol?","acceptedAnswer":{"@type":"Answer","text":"No drying alcohols were found in the ingredient list. The brand also lists it as fragrance-free."}},{"@type":"Question","name":"Will it clog pores (comedogenicity)?","acceptedAnswer":{"@type":"Answer","text":"Unlikely — the highest comedogenic rating in the formula is 1/5."}},{"@type":"Question","name":"Is it vegan?","acceptedAnswer":{"@type":"Answer","text":"Yes — the brand lists this product as vegan."}}]}</script>

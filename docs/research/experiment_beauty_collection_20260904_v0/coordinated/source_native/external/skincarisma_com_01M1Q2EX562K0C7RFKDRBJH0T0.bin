    <script>
      // Graceful product-image fallback: when a product photo fails to load (e.g. an
      // unreachable CDN url), swap the broken <img> for the brand monogram tile so the
      // card never shows a blank box. Style + initials are carried on the .pc-img box.
      window.productImgFallback = function (img) {
        var box = img.closest ? img.closest('.pc-img') : null;
        if (!box) { img.style.display = 'none'; return; }
        box.classList.add('pc-mono');
        if (box.dataset && box.dataset.monoStyle) box.setAttribute('style', box.dataset.monoStyle);
        box.innerHTML = '<span class="pc-mono__initials">' + ((box.dataset && box.dataset.monoInitials) || '') + '</span>';
      };
    </script>

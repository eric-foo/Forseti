<script>
  (function () {
    var armed = false;
    function mount() {
      if (armed) return;
      armed = true;
      var tpl = document.getElementById('report-form-tpl'), host = document.getElementById('report-form-host');
      if (!tpl || !host) return;
      host.appendChild(tpl.content.cloneNode(true));
      var scripts = host.querySelectorAll('script');
      for (var i = 0; i < scripts.length; i++) {
        var s = document.createElement('script');
        for (var j = 0; j < scripts[i].attributes.length; j++) s.setAttribute(scripts[i].attributes[j].name, scripts[i].attributes[j].value);
        s.text = scripts[i].text;
        scripts[i].parentNode.replaceChild(s, scripts[i]);
      }
    }
    if (window.jQuery) { jQuery(document).on('show.bs.modal', '#product-report', mount); }
    document.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('[data-target="#product-report"]')) mount();
    }, true);
  })();
</script>



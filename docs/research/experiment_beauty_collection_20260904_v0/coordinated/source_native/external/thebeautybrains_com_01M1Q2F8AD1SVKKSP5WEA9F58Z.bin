/static/chunks/3xnt26d00_zk-.js\",\"/_next/static/chunks/1jlysr8cp4pm9.js\",\"/_next/static/chunks/42spz6paskvb6.js\",\"/_next/static/chunks/06x30xgfe6iur.js\",\"/_next/static/chunks/1zu2-5qk7iyix.js\",\"/_next/static/chunks/4484p5ab64syg.js\"],\"SignupCTA\"]\n4d:I[23832,[\"/_next/static/chunks/3xnt26d00_zk-.js\",\"/_next/static/chunks/1jlysr8cp4pm9.js\",\"/_next/static/chunks/42spz6paskvb6.js\",\"/_next/static/chunks/06x30xgfe6iur.js\",\"/_next/static/chunks/1zu2-5qk7iyix.js\",\"/_next/static/chunks/4484p5ab64syg.js\"],\"TranscriptView\"]\n3a:[\"$\",\"time\",null,{\"dateTime\":\"2025-09-08T13:00:00.000Z\",\"children\":\"September 8, 2025\"}]\n3b:[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}]\n3c:[\"$\",\"span\",null,{\"children\":\"00:56:27\"}]\n3d:[[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"$L43\",null,{\"count\":5}]]\n45:T9ca,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003ca target=\"_blank\" href=\"https://www.buzzsprout.com/1192241/fan_mail/new\"\u003eSend us Fan Mail\u003c/a\u003e\u003c/p\u003e\u003cp\u003eOn this show we cover lots of questions including…\u003c/p\u003e\u003col\u003e\u003cli\u003eHow can you tell if a new product is just a name change or the formulas are different?\u003c/li\u003e\u003cli\u003eWhy can’t companies sell mousse sunscreens?\u003c/li\u003e\u003cli\u003eWhy is purple shampoo drying?\u003c/li\u003e\u003cli\u003eWhat’s the deal with OS-01 peptide? / What are your thoughts on Molecular Mesh?\u003c/li\u003e\u003cli\u003eHow do you deal with rosacea?\u003c/li\u003e\u003c/ol\u003e\u003cp\u003e\u003cbr/\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eBeauty News\u003c/b\u003e\u003c/p\u003e\u003cp\u003e\u003ca href='https://cosmeticsbusiness.com/peptan-the-proven-collagen-powering-beauty-from-within'\u003eDo collagen supplements really improve skin?\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003ca href='https://www.glam.com/1933134/we-tried-vo5-shampoo-better-than-pantene/'\u003eIs VO5 better than Pantene\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003cb\u003eApproximate timestamps\u003c/b\u003e\u003c/p\u003e\u003cp\u003e0:00 - Intro\u003cbr/\u003e1:00 - Chit chat\u003cbr/\u003e5:45 - Beauty news - Collagen supplements\u003cbr/\u003e10:35 - VO5 vs Pantene\u003cbr/\u003e16:40 - Product reformulation\u003cbr/\u003e28:25 - Mousse sunscreen\u003cbr/\u003e34:20 - Purple shampoo\u003cbr/\u003e40:45 - OS1 and Molecular mesh\u003cbr/\u003e43:40 - Rosacea\u003cbr/\u003e53:15 - Ending\u003c/p\u003e\u003cp\u003e\u003cb\u003eFive Ways to Ask a question -\u003c/b\u003e\u003cbr/\u003e1. Send us a message through Patreon!\u003cbr/\u003e2. You can record your question on your smart phone and email to \u003ca href='mailto:thebeautybrains@gmail.com'\u003ethebeautybrains@gmail.com\u003c/a\u003e\u003cbr/\u003e3. Send it to us via social media (see links below)\u003cbr/\u003e4. Submit it through the following form - \u003ca href='https://docs.google.com/forms/d/e/1FAIpQLSeVsnUXRGwpKQU9ZOEbqgSvia1Djh19-xpEOrmoALyY6IgpOg/viewform'\u003eAsk a question\u003c/a\u003e\u003cbr/\u003e5. Leave a voice mail message: 872-216-1856\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eSocial media accounts\u003c/b\u003e\u003cbr/\u003eon Instagram we’re at \u003ca href='https://www.instagram.com/thebeautybrains2018/'\u003ethebeautybrains2018\u003c/a\u003e\u003cbr/\u003eon Twitter, we’re \u003ca href='https://twitter.com/thebeautybrains'\u003ethebeautybrains\u003c/a\u003e\u003cbr/\u003eOn Bluesky we’re at thebeautybrains\u003cbr/\u003eOn Youtube we are at \u003ca href='https://www.youtube.com/@TheBeautyBrains2018/videos'\u003ethebeautybrains2018\u003c/a\u003e\u003cbr/\u003eAnd we have a \u003ca href='https://www.facebook.com/beautybrainsblog/'\u003eFacebook page\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eValerie\u0026apos;s ingredient company - \u003ca href='https://simply-ingredients.com/'\u003eSimply Ingredients\u003c/a\u003e\u003cbr/\u003ePerry\u0026apos;s other website - \u003ca href='https://chemistscorner.com/'\u003eChemists Corner\u003c/a\u003e\u003cbr/\u003eFollow the  \u003ca href='https://www.instagram.com/porch_kitty_krew/'\u003ePorch Kitty Krew instagram account\u003c/a\u003e\u003c/p\u003e\u003cp\u003e\u003ca rel=\"payment\" href=\"https://www.patreon.com/thebeautybrains?fan_landing=true\"\u003eSupport the show\u003c/a\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"46:Tf813,"])</script><script>self.__next_f.push([1,"[{\"speaker\":\"A\",\"start\":0.48,\"end\":26.32,\"text\":\"Hi, I'm Valerie, and you're listening to the Beauty Brains. Welcome to the Beauty Brains, a show where real cosmetic chemists answer your beauty product questions and give you an insider's look at the cosmetic industry. This is episode 406. I'm your host, Valerie George, and with me today is Perry Romanowski. Hi, Perry.\"},{\"speaker\":\"B\",\"start\":26.82,\"end\":28.58,\"text\":\"Hello, Valerie. Great to see you.\"},{\"speaker\":\"A\",\"start\":29.06,\"end\":53.37,\"text\":\"Great to see you. I'm so excited. We're back recording because we have so many questions to cover, including how can you tell if a new product is just a name change or did the formulas change? Why can't companies sell moose sunscreens? Why is purple shampoo drying on hair? What's the deal with the OS01 peptide? And how do you deal with rosacea? But first, that chit chat.\"},{\"speaker\":\"B\",\"start\":53.77,\"end\":55.37,\"text\":\"Valerie, it's good to see you up.\"},{\"speaker\":\"A\",\"start\":55.45,\"end\":58.65,\"text\":\"My shift started about seven hours ago at two in the morning.\"},{\"speaker\":\"B\",\"start\":58.81,\"end\":65.05,\"text\":\"You know, if you're getting up that early, you might as well also just get a cat too, because that's the time they like to get up to eat.\"},{\"speaker\":\"A\",\"start\":65.53,\"end\":83.54,\"text\":\"Well, pretty kitties. Kittens are out running about, and I'm trying to catch them, but it's just so hard now that I have baby C to get the traps and all that kind of stuff. But I should ask someone in the Dallas area to help out with that. But then Butch and Frank would go crazy.\"},{\"speaker\":\"B\",\"start\":84.74,\"end\":86.9,\"text\":\"You know, how have the dogs been with the baby?\"},{\"speaker\":\"A\",\"start\":87.54,\"end\":102.26,\"text\":\"You know, at first they were like, what is this? And then I think they had a little trauma in their past life with the baby because they got really upset when they saw the stroller. But they really like him now, mostly because they like to lick his vomit.\"},{\"speaker\":\"B\",\"start\":104.63,\"end\":107.35,\"text\":\"Well, I suppose there's a lot of protein in there for them.\"},{\"speaker\":\"A\",\"start\":107.35,\"end\":107.79,\"text\":\"Yeah.\"},{\"speaker\":\"B\",\"start\":107.79,\"end\":108.31,\"text\":\"Ew.\"},{\"speaker\":\"A\",\"start\":108.87,\"end\":118.87,\"text\":\"Well, remember last week we talked about Dr. Emmy skin? It was this German skincare brand by dermatologist Dr. Emmy Arpa. And I said it had Barbara Sturm vibes. Sure.\"},{\"speaker\":\"B\",\"start\":118.95,\"end\":120.15,\"text\":\"Episode 405.\"},{\"speaker\":\"A\",\"start\":120.23,\"end\":133.19,\"text\":\"Yeah, well, yeah, it was very recent. So I did order some products because I love the color yellow. And all I have to say is I better get my hat. So remember, they were offering this hat with UPF value or whatnot.\"},{\"speaker\":\"B\",\"start\":133.64,\"end\":136.36,\"text\":\"Right. The hat got you. I recall it did.\"},{\"speaker\":\"A\",\"start\":136.6,\"end\":174.25,\"text\":\"So I had. I placed an order. I didn't see the hat in the cart, but I saw the advertisement on the website. Like, you get your free hat if you place an order. And so I wrote them. All I have to say is that hat better come in the mail because if it doesn't, I have qualms. With them. Anyway, I wrote them and I said, please make sure the hat is in the package. I actually have to ship it to my cousin in Germany because it's been in the beauty news. I know we're not in beauty news yet, but a lot of people are upset that they can't get their cosmetic products from Europe shipped to them because the postal carriers aren't shipping to the US Right now.\"},{\"speaker\":\"B\",\"start\":174.65,\"end\":182.81,\"text\":\"Right. I did see in the news that countries around the world have all decided not to ship stuff to the US and that's because what, the tariffs and stuff?\"},{\"speaker\":\"A\",\"start\":182.89,\"end\":243.67,\"text\":\"Well, the tariff situation changed. So basically you had a de minimis exemption before, where if the value was under $800, it could enter duty free. The US is saying, well, you actually have to pay some tariffs on that. That's ending. And so these other countries aren't protesting the fact that US Citizens have to pay tariffs on package receipts or people in the US Receiving packages, But it's more or less like the process is unclear because U.S. customs hasn't come out with how they're going to calculate duties, pretty much. So they just did. They just stopped a little bit for a little bit. It'll pick back up again. It has nothing to do with, you know, anything, because other countries pay tariffs all the time and importing fees. Like, if you ship to Canada, you have to pay some fees when you get your package. Well, I'm gonna get my Emmy Arpa skincare. We'll just have to figure out how. Even if I have to go to Germany to get it, which I will be going to Germany, but I might have to wait to get it.\"},{\"speaker\":\"B\",\"start\":244.08,\"end\":245.52,\"text\":\"Yeah. When are you going to Germany?\"},{\"speaker\":\"A\",\"start\":246.56,\"end\":253.04,\"text\":\"Well, I was planning to go before in cosmetics in Paris next year, but I have to go sooner to get my skincare.\"},{\"speaker\":\"B\",\"start\":253.12,\"end\":261.92,\"text\":\"Oh, there you go. Well, you'll have to let us know how that goes. And I'll let you know, if there's anything you want me to pick up while I'm in France, you let me know.\"},{\"speaker\":\"A\",\"start\":262.48,\"end\":267.44,\"text\":\"Ooh, great idea. Anything happen with you in the last week?\"},{\"speaker\":\"B\",\"start\":267.68,\"end\":270.64,\"text\":\"I went golfing yesterday at, like, seven in the morning.\"},{\"speaker\":\"A\",\"start\":271.46,\"end\":272.66,\"text\":\"Did you wear your sunscreen?\"},{\"speaker\":\"B\",\"start\":273.06,\"end\":283.02,\"text\":\"You know I did not. Because I wore long sleeves and long pants. Because you know what? It's the end of August and it's cold. Like, how is it cold in the end of August in Chicago?\"},{\"speaker\":\"A\",\"start\":283.02,\"end\":287.3,\"text\":\"This is Chicago. I'll trade you places. It is still so hot here in Texas.\"},{\"speaker\":\"B\",\"start\":287.3,\"end\":287.78,\"text\":\"Oh, really?\"},{\"speaker\":\"A\",\"start\":288.18,\"end\":292.26,\"text\":\"Oh, my gosh. But I have a question. Weren't you worried about exposing your neck and Face.\"},{\"speaker\":\"B\",\"start\":293.14,\"end\":295.38,\"text\":\"I mean, I wear a hat also.\"},{\"speaker\":\"A\",\"start\":295.94,\"end\":298.58,\"text\":\"And is it a wide brim hat or a baseball hat?\"},{\"speaker\":\"B\",\"start\":298.76,\"end\":303.08,\"text\":\"It's a. It's a golf hat. It's a very stylish golf hat.\"},{\"speaker\":\"A\",\"start\":303.08,\"end\":304.12,\"text\":\"What's a golf hat?\"},{\"speaker\":\"B\",\"start\":304.28,\"end\":307.12,\"text\":\"It's like a old timer, but it's.\"},{\"speaker\":\"A\",\"start\":307.12,\"end\":313.4,\"text\":\"Similar to a baseball hat. Oh, yes, yes, yes. No, it is not similar to a baseball hat. Oh, it's similar.\"},{\"speaker\":\"B\",\"start\":313.4,\"end\":314.44,\"text\":\"It has like a rib.\"},{\"speaker\":\"A\",\"start\":314.92,\"end\":317,\"text\":\"I don't know, it goes on your head. It's similar.\"},{\"speaker\":\"B\",\"start\":317.4,\"end\":319.12,\"text\":\"It is very similar.\"},{\"speaker\":\"A\",\"start\":319.12,\"end\":319.88,\"text\":\"Oh, goodness.\"},{\"speaker\":\"B\",\"start\":320.04,\"end\":330.49,\"text\":\"Well, you know, that's such a frustrating sport, though, because, like, I play it all the time and I never get better. I never get worse, but I never get better. And it's like you spend all this time, you should get better at something. But I don't.\"},{\"speaker\":\"A\",\"start\":330.97,\"end\":335.85,\"text\":\"That's usually how it goes. So it's. Oh, well, golf is difficult.\"},{\"speaker\":\"B\",\"start\":336.17,\"end\":341.369,\"text\":\"It is. Well, yeah, for some people. For me, obviously, although I have high expectations.\"},{\"speaker\":\"A\",\"start\":341.69,\"end\":346.49,\"text\":\"Well, it hasn't been a difficult week in beauty news. It actually was pretty light. So let's head over there.\"},{\"speaker\":\"B\",\"start\":351.37,\"end\":369.23,\"text\":\"Valerie, my old brand was in the news. I saw this article about which. Which tickled me. It's like from glam. They said, we tried V5 shampoo and its plumping effect vastly outshines Pantene's viral comeback.\"},{\"speaker\":\"A\",\"start\":370.19,\"end\":374.67,\"text\":\"Well, they're two completely different shampoos, so how could you even compare them?\"},{\"speaker\":\"B\",\"start\":375.31,\"end\":393.65,\"text\":\"Well, I mean, they are all just about the claims, right? And so brands like Pantene, they say, have been like the go to and they get a lot of press on the Internet, I guess, because, you know, P and G is very good at, well, advertising.\"},{\"speaker\":\"A\",\"start\":393.81,\"end\":396.29,\"text\":\"They spend a lot, especially their flagship.\"},{\"speaker\":\"B\",\"start\":396.29,\"end\":443.78,\"text\":\"Shampoo for sure, which has been the number one shampoo in the United States since at least 2000. Well, I've seen this complaint about Pantene a lot. People say, oh, it leaves a residue on your hair. So some, you know, some people would wrongly say, oh, it's leaving plastic on your hair, but it does leave a film on your hair. And this person used it and she says for her curly hair and it wasn't quite right. But then she said VO5 caught my attention, thanks to the scents and the benefits of ranging from moisturizing to clarifying and revitalizing. Oh, my God. And she said, I tried it and it worked better for my hair than Pantene.\"},{\"speaker\":\"A\",\"start\":444.26,\"end\":469.14,\"text\":\"I bet you. I mean, a VO5 works, but it's just different than Pantene. Right. So I just don't feel like you could even compare them. And I also wonder if VO5 caught their eye because, like, the early 90s are back in, and the early 2000s are back in. And so it's like, oh, let me just look at these, like, drugstore shampoos. Because that's where people get them, right?\"},{\"speaker\":\"B\",\"start\":469.14,\"end\":487.74,\"text\":\"Well, I think the beauty of VO5, I mean, it's the cost, of course, but they do a good job with bright colors and lots of fragrance. And so if you like that kind of thing, that was very popular, like Bath and Body Works is very popular in malls and stuff.\"},{\"speaker\":\"A\",\"start\":487.74,\"end\":495.55,\"text\":\"And that's what I'm saying. It's back in. It's just trending. In two years, people won't care about VO5 again.\"},{\"speaker\":\"B\",\"start\":496.35,\"end\":503.71,\"text\":\"No, VO5 has been around since the 1950s. It's never going away. I mean, it's never gonna be fine with it.\"},{\"speaker\":\"A\",\"start\":504.189,\"end\":507.95,\"text\":\"It's not gonna be in glam.com ever again. That's what I'm saying.\"},{\"speaker\":\"B\",\"start\":508.67,\"end\":532.18,\"text\":\"Well, until the next zillennial or whatever the next generation is, they discover the old timer and like, hey, because I think, like, 99 cent shampoo. Well, I guess it's not 99 cents anymore. It's probably $1.59 or something. Cheap shampoos are never going to go away. There's always going to be the basic Bobs and the basic Betty's, as we call them in marketing research, who want these kinds of products.\"},{\"speaker\":\"A\",\"start\":533.3,\"end\":541.06,\"text\":\"Well, I did recommend some inexpensive shampoos to the arborists that came to our home to take care of some of our mulberry trees.\"},{\"speaker\":\"B\",\"start\":541.14,\"end\":542.66,\"text\":\"And for the trees.\"},{\"speaker\":\"A\",\"start\":543.69,\"end\":553.29,\"text\":\"Well, for himself selling the treatment, he took his hat off. He took his hat off and said, can you recommend, like, what shampoo should I be buying? And I just said, honestly, the cheapest.\"},{\"speaker\":\"B\",\"start\":553.69,\"end\":556.57,\"text\":\"All right, so get him. Get him VO5 or Suave.\"},{\"speaker\":\"A\",\"start\":557.45,\"end\":558.57,\"text\":\"That's what I recommended.\"},{\"speaker\":\"B\",\"start\":558.81,\"end\":565.69,\"text\":\"You know, when I was on VO5, there was Suave, and then there was another cheap shampoo called White Rain.\"},{\"speaker\":\"A\",\"start\":567.13,\"end\":579.3,\"text\":\"The White Rain. What White Rain is gone. But they had this hairspray. It was in the green. White Rain was a white package for the most part. And it had, like, an accent color on it.\"},{\"speaker\":\"B\",\"start\":579.54,\"end\":579.98,\"text\":\"Okay.\"},{\"speaker\":\"A\",\"start\":579.98,\"end\":607.38,\"text\":\"And there was a White Rain hairspray that was. Had the green cap and, like, the green raindrop on it. Oh, the first napkin smelled so good that we would just. My friend had it and we would just spray it in her house as, like, air freshener because it smelled so good. I remember the scent, and sometimes I'm like, what happened to that? That's so funny. I Just thought about that the other day.\"},{\"speaker\":\"B\",\"start\":607.62,\"end\":609.3,\"text\":\"It was owned by Gillette.\"},{\"speaker\":\"A\",\"start\":609.7,\"end\":610.34,\"text\":\"Okay.\"},{\"speaker\":\"B\",\"start\":610.5,\"end\":613.62,\"text\":\"And then Gillette got bought by, I think, P and G, right?\"},{\"speaker\":\"A\",\"start\":614.58,\"end\":618.5,\"text\":\"No, did Gillette get bought by Comb or P and G?\"},{\"speaker\":\"B\",\"start\":618.98,\"end\":620.5,\"text\":\"I thought it was P and G.\"},{\"speaker\":\"A\",\"start\":620.5,\"end\":622.7,\"text\":\"Yeah, it's probably P and G. Yeah.\"},{\"speaker\":\"B\",\"start\":622.77,\"end\":627.97,\"text\":\"Yeah. So. And then P and G doesn't want small brands like that or Procter and Gamble.\"},{\"speaker\":\"A\",\"start\":627.97,\"end\":630.41,\"text\":\"Is P and G everybody. Industry vernacular.\"},{\"speaker\":\"B\",\"start\":630.41,\"end\":636.13,\"text\":\"Oh, that's right. I think P and G is out in the. It's out in the public world.\"},{\"speaker\":\"A\",\"start\":636.13,\"end\":637.81,\"text\":\"Png it might be, yeah.\"},{\"speaker\":\"B\",\"start\":638.05,\"end\":638.53,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":638.53,\"end\":669.82,\"text\":\"Well, I saw something that I thought would really stick in your craw. Do collagen supplements really improve skin? It was an article in Cosmetics business and it's about this, I guess, peptide or collagen called Peptan. I felt like. Yeah, felt like a paid spot of sorts in this news website, we'll call it. But basically it's a collagen peptide that you consume and they have some benefits for skin and hair.\"},{\"speaker\":\"B\",\"start\":670.86,\"end\":759.46,\"text\":\"What I saw here is that says they sort of hammer the science. Scientifically proven one or, you know, backed by science. And I don't know, I, I'm a collagen supplement skeptic because it's very difficult to prove that, oh, I've eaten this thing and it's had this effect on my skin, specifically because the way biology works is when you eat something, it goes into your stomach, it's broken down to these smaller peptides and then gets digested. So whether you're eating a collagen or you're eating fish or you're eating a hamburger, it all kind of gets turned into the kind of same stuff. Now, there are some who will say that, well, collagen gets turned into a peptide, that you don't find other types of food sources. And I mean, maybe that's true. Again, I'm. I find that a dubious claim that then it's going to go specifically to your skin and have effects. So, you know, I remain a collagen ingestion skeptic mostly because you make extraordinary claims like what you eat is going to impact your skin. That to me is an extraordinary claim, like in some specific way. And I don't see extraordinary evidence for this being true.\"},{\"speaker\":\"A\",\"start\":760.5,\"end\":814.23,\"text\":\"They didn't go into the science behind the collagen peptide. Like how is it different than other collagen or other peptides? But they do claim it has high bioavailability, which means your body absorbs more of it than it ordinarily would, presumably due to the peptide sequence. Maybe. But again, they don't go into that. They just go into their two clinical trials that show it improves skin density, elasticity and hydration while also reducing wrinkle visibility. Again, really hard to do from the inside out. Then they did a study where peptan stimulated the number of active stem cells and hair follicles to slow their decline. They don't have any proof that it does anything for hair loss, but it suggests a pro promising approach to counteract age related hair loss. So it's just really suggestive in the language and I'm just not sure that it would do that.\"},{\"speaker\":\"B\",\"start\":815.19,\"end\":834.18,\"text\":\"Again, they're implying these incredible claims, oh, here, eat this and your hair will fall out less slowly. Okay. I mean, that would be great if that were true. Let's prove it more than just like, oh, you know, we saw in a lab that, oh, this could happen.\"},{\"speaker\":\"A\",\"start\":834.26,\"end\":863.95,\"text\":\"Like, come on, you know, I'm not against, like consuming collagen, like vital collagen or whatnot, because if, you know, you're still consuming something that's beneficial. And I actually don't have a high protein diet. I actually don't think most people eat enough protein. But, you know, if it doesn't hurt, it, you know, doesn't hurt. Yeah, but I just don't like the way vital collagens taste. You know, like people are putting it in their coffee and it's like, this stuff tastes awful. I wonder if this is better.\"},{\"speaker\":\"B\",\"start\":864.51,\"end\":920.13,\"text\":\"Yeah, I just find that people are not skeptical enough of supplements in general, and this kind of thing just sort of boosts the supplement industry. I find the supplement industry a little bit unsavory, as it were, because pretty much it's unregulated here in the United States. And they can make all kinds of claims they want. And, you know, I know there's hugely popular podcasts that sell supplements. That's how they make a lot of money. And it's just people just don't need these things. If you're just eating a decent diet and you're taking care of yourself. I mean, you don't need to supplement with stuff like vitamins and ginkgo biloba and all this. It's all just kind of a waste of money in my mind. So maybe that bias is my view of the science behind eating collagen for your skin. I don't know.\"},{\"speaker\":\"A\",\"start\":921.41,\"end\":942.61,\"text\":\"Yeah, it's. It's very interesting. I'm reading about the manufacturer of the peptide from this peptan manufacturer, and they have a porcine version, a bovine version, a fish version, a lot of collagen does come from fish, which can explain some of the taste. But usually collagen has to come from some kind of animal source.\"},{\"speaker\":\"B\",\"start\":942.85,\"end\":950.97,\"text\":\"Right. It is surprising to me that people aren't worried about the animal derivation of collagen.\"},{\"speaker\":\"A\",\"start\":952.01,\"end\":956.89,\"text\":\"I wonder if they think about it. I don't think people think like, well, where is this collagen coming from?\"},{\"speaker\":\"B\",\"start\":957.05,\"end\":969.11,\"text\":\"Well, I mean, they think about their beauty products and like, oh, are there animal ingredients in it? And that is a big turn off. But I guess eating animals is different than using them for cosmetics.\"},{\"speaker\":\"A\",\"start\":970.22,\"end\":980.62,\"text\":\"My mentor who passed away always lamented how he missed the days where he could use beef collagen in hair because he just said it. It made the hair feel really soft and hydrated.\"},{\"speaker\":\"B\",\"start\":981.9,\"end\":991.1,\"text\":\"Well, and you know, the thing is that was not. Nobody went out and killed animals so they could put it in their cosmetics. That was just a byproduct of the meat industry.\"},{\"speaker\":\"A\",\"start\":991.58,\"end\":994.3,\"text\":\"Yeah, very true. It's the original upcycling.\"},{\"speaker\":\"B\",\"start\":994.85,\"end\":996.13,\"text\":\"That's right. It's upcycling.\"},{\"speaker\":\"A\",\"start\":996.93,\"end\":1008.13,\"text\":\"Well, what we're not upcycling is these questions. They're all brand new. Our first question comes to us from Laura, a patron.\"},{\"speaker\":\"B\",\"start\":1009.41,\"end\":1071.57,\"text\":\"Laura says, hi, beauty brains. Happy summer. Two quick questions regarding hair care. And since she is a patron, we don't mind. Two quick questions. All right. She says, I have long, light brown colored hair with black blonde highlights and it is very dry. Previously I used and liked l' Oreal Elvive Extraordinary Oil Rapid Reviver Power Conditioner. Wow. L'. Oreal. Thanks for the very long names. However, it seems it was discontinued and replaced with the l' Oreal Elvive Total Repairs Power Restored for damaged hair. Would you know if this is true? I do like the power restore too, but they seem a little different. All right. It's not uncommon, I guess, for a company to replace one line with another. It sort of streamlines things and it. I guess it makes production easier and more efficient. But what happens usually when they do replace stuff like that?\"},{\"speaker\":\"A\",\"start\":1072.05,\"end\":1122.38,\"text\":\"Well, this might not be a. A total renaming project. I mean, it might be if the l' Oreal has discovered that maybe the product's not doing as well as they thought it would and they don't perceive it to be a formulation issue and it could be a naming and product positioning issue for sure. They could have just changed the name, maybe highlighted some different product attributes, but it seems that maybe it was a reformulation and maybe the product wasn't doing great. And they said, well, why not change the name to something different? Change a Couple bells and whistles. Or maybe they just kept the same formula and tweaked a little key ingredient. That's fairy dust in the formula. It's really hard to tell. Were you able to find the ingredient list and compare them, Perry?\"},{\"speaker\":\"B\",\"start\":1123.1,\"end\":1194.13,\"text\":\"Yeah, the oil rapid Reviver, the main ingredient is amodimethicone. Up front, it's. And behem Trimonium chloride. So those are, those are the two main ones there. And for the power restore, we've got dimethicone and behem Trimonium chloride. And it also has a lower level of amodimethicone and C. Tronium chloride also. So the new one seems like it's got a few more conditioning ingredients, but kind of the same ones. Like it has amodimethicone and behentra ammonium chloride, which is, you know, the same as the. The first one, but then it has some additional ones in it. So I think as far as formulations, I could see why she might find differences because they're not exactly the same. The first one had also has camellia oleifera seed oil. So it's going to have a little more oil incorporated into it, whereas the. The new one doesn't really have any of the oils in it.\"},{\"speaker\":\"A\",\"start\":1194.61,\"end\":1211.9,\"text\":\"Well, it makes sense. The first one was an oil in the name Rapid Reviver, whereas the new one is more about power restore and repair. So presumably more conditioning agents makes a little sense. So sounds like it maybe wasn't a reformulation, but a different formulation.\"},{\"speaker\":\"B\",\"start\":1212.7,\"end\":1225.42,\"text\":\"Right. So for whatever reason, they replaced this one that you used to like with something new. And it's probably because not enough people were buying the one that they replaced.\"},{\"speaker\":\"A\",\"start\":1225.82,\"end\":1232.94,\"text\":\"Yeah, that's true. Or, you know, oils are inexpensive until the crop goes bad. Right?\"},{\"speaker\":\"B\",\"start\":1232.94,\"end\":1233.3,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":1233.3,\"end\":1248.7,\"text\":\"So then they say, well, we need something that's maybe not dependent on crops. And. And so they could have done it for cost cutting measures as well. Or maybe they didn't make the formula themselves and they wanted to produce something that they make on their own.\"},{\"speaker\":\"B\",\"start\":1249.42,\"end\":1270.02,\"text\":\"That's right, because l' Oreal will. First they buy a bunch of brands and they also use contract manufacturers. So usually I would imagine, though, a company like l' Oreal, as a contract manufacturer, they're going to own their formulas. But if they bought a company, they might not necessarily own that formula.\"},{\"speaker\":\"A\",\"start\":1270.34,\"end\":1302.75,\"text\":\"Well, that's not necessarily the case, Perry. Just a few weeks ago we talked about Urban Decay, which is a l' Oreal owned brand, and the contract manufacturer that used to make that setting spray. L' Oreal pulled that business, launched Their own version of it. And the manufacturer who invented this best selling setting spray has been very public about the separation. So yeah, it's totally possible that a contract manufacturer was making this extraordinary oil rapid reviver for them.\"},{\"speaker\":\"B\",\"start\":1303.55,\"end\":1317.15,\"text\":\"Yeah, yeah. No, you, you are correct. All right, well that's that. And you know, I hope you. I mean they still use the main conditioning ingredients of amodimethicone and behem trimonium chloride. So I think you're going to get a lot of the same benefits.\"},{\"speaker\":\"A\",\"start\":1317.55,\"end\":1322.27,\"text\":\"Similar. Slightly different. Yeah. Well, Laura had a second question. What was it said?\"},{\"speaker\":\"B\",\"start\":1322.27,\"end\":1347.99,\"text\":\"Recently my stylist used K18 shampoo and conditioner on my hair. I've never heard of it and see it is a Unilever brand. Any comments on that line? My stylist was sold and assured me it was the best thing for my bleached dry hair. Please share your thoughts and we. I appreciate all you do, Laura. Wow. K18, she hasn't heard of it. She must not be on social media because that was everywhere, right?\"},{\"speaker\":\"A\",\"start\":1348.19,\"end\":1375.33,\"text\":\"Oh my gosh. Especially in the salon professional circles for sure. So K18 is a new Unilever brand. It was actually just acquired within the last couple years at 3 years old. An insane amount of money for it. And we'll talk about what happens as a Unilever brand in a second. But it was an independent brand before that and a lot of people are hooked on it. They did a great job getting their first foot in the door of salons.\"},{\"speaker\":\"B\",\"start\":1375.65,\"end\":1412.17,\"text\":\"Essentially what it is is one of these bond builders. Olaplex was the first popular one and that was based on some mercaptan chemical technology or something like that. K18, their bond builders are based on peptides. So they create this peptide that's supposed to build bonds and hair and make your hair better. And then they did a heck of a marketing job on salons and they built built their K18 as the alternative to Olaplex and you know, did did quite well. Well enough to get the attention of Unilever who just bought them right up.\"},{\"speaker\":\"A\",\"start\":1413.21,\"end\":1427.93,\"text\":\"So what happens when a company buys a another brand? So I know that you worked at Alberto Culver that was bought by Unilever and I've heard from some ex Alberto employees, not you, that it was Uniqleiver bought them.\"},{\"speaker\":\"B\",\"start\":1428.17,\"end\":1531.17,\"text\":\"Right. Well, we, this happens a lot with any big brand. A big brand or big company will find a brand that is doing well and it's easier to buy up something that's already doing well than to develop a whole new brand yourself. You know, Unilever. There's nothing K18 did that Unilever couldn't have done. But Unilever has got to figure, well, it's just easier for us to buy you up and take, take the goodwill that's already been developed by your marketing on your own. So it's almost like small brands are like the minor leagues for brands until the big, until they get called up to the show, the big guys buy you. But what happens when a company buys you is that they try to consolidate things like manufacturing, marketing and R and D. And consolidate just means they shut you down and they make you move to Trumbull, Connecticut or something where Unilever is. Unilever bought out Helen Curtis, which used to make, in the Chicago area. They make salon selective swabs, all of those. And they bought them out and they, they were gonna develop a hair care research center in Chicago and that lasted for like 10 years. And they're like, nah, we won't do that. And so they shut them down and they moved everybody to east coast or everybody here in Chicago that they either had to find jobs or move. And that's kind of what happens when you buy, when a big company will buy another. So I don't know where K18 was originally located. They probably didn't have a lot of scientists behind this. I mean you wouldn't really need that many, right?\"},{\"speaker\":\"A\",\"start\":1532.13,\"end\":1572.36,\"text\":\"No. A brand like this is, you know, probably using contract manufacturers and, and whatnot because it's very rare. Yes, they had this ingredient developed, but not many brands starting out have their own facilities. I would say that's pretty, pretty rare. Now the products themselves are all right. So I used to work at a salon brand. We've tested everything K18. And you know, the, the spray is really what put them on the map. It's this spray that contains a concentrated level of this pest peptide that they have. And that's a really fine product. But the shampoos and conditioners, I mean I, I'm not impressed.\"},{\"speaker\":\"B\",\"start\":1573.24,\"end\":1595.27,\"text\":\"Well, also they're rinse out, right? So you can't really deliver much from a shampoo. So when you, these bond builders, they're just washing out from a shampoo mostly a conditioner maybe can get a little bit more delivery. But it's really the sprays, the leave on products where you're going to have the maximum effect of the, these bond builders.\"},{\"speaker\":\"A\",\"start\":1596.39,\"end\":1673.62,\"text\":\"Sometimes when you have a key ingredient story, I actually think it can be detrimental to a hair brand. Yeah, I'll tell you why, Perry, because people think I have this One ingredient, I could just throw it in any shampoo and, or conditioner and it's going to really change the way the product works. And the reality is in hair care, an ingredient doesn't necessarily transform the shampoo, how the shampoo is put together. And it's not very easy to formulate shampoos or conditioners. I mean, sure, a lot of people can make them, they can't make really good ones. And so when you have to me like a subpar surfactant chassis and then you put this like key ingredient in it, you're just not going to see the results I think that you're, you're looking for. Because it's pretty much like any other shampoo on the market with you know, maybe this like peptide tossed in and two, they use in a couple of their shampoos. Just a surfactant combination that I'm not a really big fan of. So if you were going to try the K18 products, I would probably recommend their leave in molecular repair spray and their mask. Their mask is all right.\"},{\"speaker\":\"B\",\"start\":1674.34,\"end\":1707.16,\"text\":\"Yeah. And as far as the, when the big company bought them, they probably change the formulas. They will, they'll change the formulas eventually. So that would probably, you know, Unilever has some good shampoo formulas. I mean they have Tresemme now that they took from us now, but you know, that's a good performing shampoo. So I could totally see them adapting one of their more consumer liked formulas to the K18 technology. And maybe people like the shampoo better. I don't know.\"},{\"speaker\":\"A\",\"start\":1707.24,\"end\":1726.84,\"text\":\"We'll see. Our second question comes to us from Misty, also a patron. Hi beauty brains. I saw the FDA issued a warning letter to companies like Supergoop and Vacation that make Moose sunscreens. The language is really confusing. Is it because mousse has not been studied and approved by the FDA as a format?\"},{\"speaker\":\"B\",\"start\":1727.81,\"end\":1744.85,\"text\":\"Well, this is a great question, Misty, and yes, you're right. I mean it's probably been studied but Moose has not been approved by the FDA as a format. And so that is specifically why these companies got that letter.\"},{\"speaker\":\"A\",\"start\":1745.57,\"end\":1775.44,\"text\":\"It's interesting because they've actually had this mousse format sunscreen out for a while and other supergoop has other brands have as well. There's tons of brands that have sunscreens in powder format or wipe format which are also not allowed formats. And people have wondered, oh, why is the FDA spending resources on this now? And I actually think it was because Wall Street Journal had a huge article on vacation and how they've made sunscreen. Fun again.\"},{\"speaker\":\"B\",\"start\":1775.84,\"end\":1776.32,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":1776.32,\"end\":1816.43,\"text\":\"And there's nothing more than a government hates than the word fun. So I'm sure that quickly got the attention of the FDA and said sunscreens cannot be fun. And so they've. I don't know why I said that in a pseudo Arnold Schwarzenegger voice. But anyway, they said, whoa, let's stop making this fun, because mousse is not an approved format. Although if I were a lawyer on this case for the brands, I would say isn't technically mousse lotion with temporary air placed inside. Theoretically, once it's put onto the skin, the air volatilizes and that becomes, once again, lotion.\"},{\"speaker\":\"B\",\"start\":1817.07,\"end\":1857.13,\"text\":\"You know, they should hire you as an expert witness. Yeah. You know, I think the important thing to know here, too, is just because the FDA called these companies out, that doesn't mean the moose form isn't an effective sunscreen. I'm sure if they put SPF on their thing, they probably went and did SPF testing using the mousse and using the levels that you're supposed to use, and they showed that it was working the way they say it is. But the FDA just says, hey, it's not an approved format, so you can't do that. So it's not about does it work or not.\"},{\"speaker\":\"A\",\"start\":1858.25,\"end\":1868.3,\"text\":\"Now, could the brands petition the FDA to make this an approved format through some kind of not new drug application? Because it's not necessarily a new drug active.\"},{\"speaker\":\"B\",\"start\":1868.3,\"end\":1891.42,\"text\":\"But no, they could submit a new drug application, an NDA, and the FDA could approve that, but you have to do that on every formula. So you, you, you couldn't just do that. Oh, on this mousse in general, and then you can make a bunch of different formulas. No, you have to make the same formula. And so that's why NDAs are not done very often with something like a sunscreen.\"},{\"speaker\":\"A\",\"start\":1891.74,\"end\":1905.42,\"text\":\"Well, if I were vacation, I would do it because this formula is pretty good. Yeah, mostly it's the fragrance, I'm not going to lie. Also, I do generally like mousse formats because I think foam in the hand is really fun, but I'm not.\"},{\"speaker\":\"B\",\"start\":1905.42,\"end\":1914.92,\"text\":\"I've not used the mousse as a sunscreen. Is it easy to apply? I don't think it would seem like it would be a little sticky, you know.\"},{\"speaker\":\"A\",\"start\":1914.92,\"end\":1930.6,\"text\":\"Yeah. But again, I think it's about it being different. It's fun. You know, I'm a foam hand sanitizer, a foam hand soap kind of girl. So, yeah, you know, for me, that doesn't bother me. It's. No, no, different than any other, you know.\"},{\"speaker\":\"B\",\"start\":1931,\"end\":1931.4,\"text\":\"Sure.\"},{\"speaker\":\"A\",\"start\":1931.48,\"end\":1933.4,\"text\":\"Sunscreen in that type of sense.\"},{\"speaker\":\"B\",\"start\":1933.56,\"end\":1934.44,\"text\":\"Right, right, right.\"},{\"speaker\":\"A\",\"start\":1934.84,\"end\":1935.24,\"text\":\"Yeah.\"},{\"speaker\":\"B\",\"start\":1935.24,\"end\":1937.56,\"text\":\"I suppose it doesn't have to be sticky either.\"},{\"speaker\":\"A\",\"start\":1938.28,\"end\":1954.31,\"text\":\"No. The only other thing is, I think I feel like they also got reprimanded a little bit because one thing you can't do is have cosmetic products look like food without some kind of warning, or you have to specifically say they're not for kids.\"},{\"speaker\":\"B\",\"start\":1954.79,\"end\":1955.11,\"text\":\"Right.\"},{\"speaker\":\"A\",\"start\":1955.11,\"end\":1978.43,\"text\":\"I think because children's products, even like children's cosmetic products are regulated in that sense where it can't look like it's edible, it's in a whipped cream package like you would get at the grocery store. It just has whip in the hand. I mean, it looks like it could be a food. Food item. And so I. I feel like I recall someone saying that was also an issue.\"},{\"speaker\":\"B\",\"start\":1978.99,\"end\":2006.35,\"text\":\"That. Yeah, that's probably correct. So I think the bottom line here is that it's not about whether it's been studied or not. It, you know, I'm sure it's studied and you can make effective SPF with a moose version. It's just not approved by the fda. And, you know, they're slow to approve stuff. In fact, I thought sprays for the. For a long time, sprays were not really legal, but somehow they got approved eventually.\"},{\"speaker\":\"A\",\"start\":2006.91,\"end\":2012.35,\"text\":\"Yeah. So what happens? Do they have to pull it from the market? Like, what's the outcome?\"},{\"speaker\":\"B\",\"start\":2013.47,\"end\":2022.15,\"text\":\"Yeah, I think they will have to either pull it from the market or they're going to have to fill out the application. Yes, do it. Do an NDA.\"},{\"speaker\":\"A\",\"start\":2022.15,\"end\":2029.31,\"text\":\"So, well, get the vacation Moose sunscreen while you can. I still see it's on the Ulta website, and so I'll pick a couple up.\"},{\"speaker\":\"B\",\"start\":2029.76,\"end\":2042.6,\"text\":\"There's a brand like Kalani Sunwear. They've already pulled their mousse sunscreens from the US Website. So some people are already reacting to this being preemptive. They are.\"},{\"speaker\":\"A\",\"start\":2042.6,\"end\":2047.92,\"text\":\"Is preemptive the word preemptive? Yeah, they're. They're being precautionary.\"},{\"speaker\":\"B\",\"start\":2048.24,\"end\":2050.96,\"text\":\"Yeah, sure. I think preemptive works there.\"},{\"speaker\":\"A\",\"start\":2051.28,\"end\":2053.12,\"text\":\"I don't know. I wasn't an English major.\"},{\"speaker\":\"B\",\"start\":2053.6,\"end\":2058.96,\"text\":\"You know what works also is this audio question that we have. Let me. Let me cue that up.\"},{\"speaker\":\"C\",\"start\":2059.6,\"end\":2092.98,\"text\":\"Hi, beauty brains. My name is Emma and I'm a hairstylist. And I have a question about purple shampoo and why it's so drying. One of the things that my clients complain to me the most about purple shampoo is how dry it makes their hair feel after they use it. I suggest mixing it with regular shampoo or their regular Shampoo to try and combat that. But what ingredients are in purple shampoo so specifically that make it so drying to everyone's hair? I love listening to your podcast. It's one of my favorite parts of my day. Keep doing what you're doing. It's great. Thank you.\"},{\"speaker\":\"A\",\"start\":2093.3,\"end\":2103.14,\"text\":\"Oh, thank you, Emma. We love that the show's the favorite part of your day. That makes me feel really good about how I felt last week where I was a little in the dumps about our reviews.\"},{\"speaker\":\"B\",\"start\":2103.22,\"end\":2106.18,\"text\":\"They love the chit chat, you know, so there you go.\"},{\"speaker\":\"A\",\"start\":2106.66,\"end\":2110.02,\"text\":\"Oh, wow. Well, we know a bit about purple shampoo.\"},{\"speaker\":\"B\",\"start\":2110.5,\"end\":2117.3,\"text\":\"Yeah, purple shampoo is the one that is used to make your gray hair kind of blend in and disappear.\"},{\"speaker\":\"A\",\"start\":2118.1,\"end\":2123.94,\"text\":\"Or if you have yellow hair from bleaching and you have this yellow pigment left, it helps neutralize it.\"},{\"speaker\":\"B\",\"start\":2124.02,\"end\":2131.3,\"text\":\"Yeah. So it just makes your hair look better. And it all features the dye. What is it? External DNC violet number two.\"},{\"speaker\":\"A\",\"start\":2131.3,\"end\":2134.74,\"text\":\"Is that also known as acid violet 43 in Europe?\"},{\"speaker\":\"B\",\"start\":2134.74,\"end\":2136.44,\"text\":\"Oh, there it is. There you go.\"},{\"speaker\":\"A\",\"start\":2136.44,\"end\":2138.52,\"text\":\"So I call it acid violet 43.\"},{\"speaker\":\"B\",\"start\":2139.72,\"end\":2143.32,\"text\":\"Well, I'm old school. External D and C violet number two.\"},{\"speaker\":\"A\",\"start\":2143.8,\"end\":2159.72,\"text\":\"Well, I can't. I can never remember if it gets, like, if it's just D and C, if the external has to be there, or if it's, you know, just D and C violet too. So I just say, you know what, call it by the acid dye name and you don't have to worry about that.\"},{\"speaker\":\"B\",\"start\":2159.88,\"end\":2171.2,\"text\":\"It's changed over the years. You know, when we were working with this, we, we, for some reason, you know, when we're working in the lab, because you use these dye powders at such tiny, tiny levels.\"},{\"speaker\":\"A\",\"start\":2171.2,\"end\":2173.08,\"text\":\"Very tiny levels. Very tiny.\"},{\"speaker\":\"B\",\"start\":2173.32,\"end\":2197.57,\"text\":\"You can't really measure the powder out. So to work with it in a lab, what you would do is make a solution of it. So most of them are water soluble and you could put it in. So you put in 10 grams, you make 100 grams of water. So you have a 10% solution. And that's easier to measure than the powders anyway. We did this with D and C violet too, but it wasn't completely water soluble.\"},{\"speaker\":\"A\",\"start\":2197.89,\"end\":2198.69,\"text\":\"No, it's not.\"},{\"speaker\":\"B\",\"start\":2199.81,\"end\":2210.21,\"text\":\"It's partially water soluble. So it kind of could work, but I don't know why we. I just remember the solution had like little globs floating on the top and you had to shake it before using it.\"},{\"speaker\":\"A\",\"start\":2210.29,\"end\":2251.45,\"text\":\"Well, I, I don't make solutions. I work on an analytical balance. Oh, okay. And I'm used to super teeny amounts. And then knowing, like, where the scale Cuts off for any kind of accuracy. And usually it's pretty good enough. But with purple shampoo, you're right, you're using very tiny amounts, which is crazy because when you get the purple shampoo, it looks so dark purple, hugely dark purple. And consumers are like, oh my gosh, there's so much color. Is this gonna turn my hair dark purple? And it's like there's literally like four decimal places of color in this. It's not going to do anything. So. Well, not that it won't do anything, but you know, it's a use over use type product. You don't have to worry about it turning your hair dark purple.\"},{\"speaker\":\"B\",\"start\":2252.25,\"end\":2269.29,\"text\":\"So as far as this drying piece goes, it is a little surprising to me that people report that it's drying because otherwise it's a regular shampoo. It just has this purple dye in it and it's in there at such a tiny amount. Why is this causing the dryness in hair?\"},{\"speaker\":\"A\",\"start\":2269.79,\"end\":2298.6,\"text\":\"Well, believe it or not, this purple shampoo dye, acid violet 43 is actually a bit negatively charged in character. So I wouldn't say it's in any ordinary shampoo. The shampoo can't really have conditioning agents in it because they would complex with this negatively charged dye. And so for this reason, any purple shampoo product tends to be really just a really great cleansing shampoo and doesn't.\"},{\"speaker\":\"B\",\"start\":2298.6,\"end\":2302.8,\"text\":\"Impart any moisturizing or conditioning.\"},{\"speaker\":\"A\",\"start\":2302.8,\"end\":2364.89,\"text\":\"Yeah, exactly, because it just, it really can't. Also, a purple shampoo now is so mainstream, you know, it has to have a really good price point. So they tend not to be really elaborate formulas. Also, you don't want these conditioning agents competing for the hair. You want the dye to be able to penetrate the hair. And so they're really just minimalist formulations. Also, I suspect because this dye sits on the surface of the hair, it can't really get in all the way. Consumers may be feeling some of this surface coating on the hair fiber, which may feel like the hair is dry, but it's actually just like this coating from the dye that you feel. So, multitude of factors, but essentially not a conditioning product because chemically it can't be. The formulas are pretty simple and you may be feeling the dye on the outside of the hair because this is ubiquitous across all purple shampoo brands. It's not just like one, it's like every single one. I've heard this complaint.\"},{\"speaker\":\"B\",\"start\":2365.21,\"end\":2405.07,\"text\":\"And the other thing to consider too is that people who are using these purple shampoos probably have already have dry hair. So it might just Be that your hair already is dry, but. And this shampoo is not doing anything to actually add moisturizing or conditioning to your hair. And so that could come off as, oh, it's a shampoo doing this. But it actually was your hair like that. Another piece that Emma said was that she had recommended that people mix things in with their shampoo to make it more conditioning. I. I'm not sure that that's such a great idea. Just use a conditioner afterwards.\"},{\"speaker\":\"A\",\"start\":2405.39,\"end\":2441.06,\"text\":\"Yeah, just use a conditioner afterwards. Because again, you don't want anything to interfere with that purple colorant because very little gets into the hair. Even if you use. As a chemist. If I were to put half a percent of this acid, violet 43 or external D\u0026C, violet 2 or violet number 2. See, I can't even remember if you were to put half a percent in. It doesn't really deposit a lot because it's such a huge molecule and it's negatively charged. So it's like an uphill battle to get it onto the hair. So if you just mix it with anything, you would actually be doing a disservice to what the shampoo could do.\"},{\"speaker\":\"B\",\"start\":2441.38,\"end\":2444.66,\"text\":\"Yeah, you're making the shampoo work worse. Mm.\"},{\"speaker\":\"A\",\"start\":2445.94,\"end\":2448.14,\"text\":\"Our next question comes to us from Mary Beth.\"},{\"speaker\":\"B\",\"start\":2448.14,\"end\":2448.62,\"text\":\"Hello.\"},{\"speaker\":\"A\",\"start\":2448.62,\"end\":2474.47,\"text\":\"I love your podcast. It is making me smarter about how much I believe the marketing hype around products for aging scale skin. Recently, I listened to a podcast with the founder of One Skin who talked about the discovery of the OS01 peptide, which magically reduces signs of aging skin. The products are very expensive. Have you looked into this brand? Are there other brands that have similar peptides that help aging skin? Thanks for sharing your knowledge with us. Best regards, Mary Beth in New York.\"},{\"speaker\":\"B\",\"start\":2475.51,\"end\":2499.9,\"text\":\"Oso One Peptide, One Skin again. Well, they must be doing a great job of marketing because it's generating a lot of questions. And in fact, we have talked about this a few times on episodes 344, 382 and 393. And what did we say about it, Valerie?\"},{\"speaker\":\"A\",\"start\":2501.26,\"end\":2520.16,\"text\":\"Well, we are sure they're great products and if you love the way they make you feel, then keep using them. But it's just very hard to have proof that peptides do anything, especially when any data comes from the brand. Right. You have to take it with a little bit of grain of salt when.\"},{\"speaker\":\"B\",\"start\":2520.16,\"end\":2576.51,\"text\":\"You have a small brand like Oneskin. And I'm sure the founder goes onto a podcast and they just say, ah, it's the best products. That's. What else are they gonna say? But when you're thinking of the technology and developing of skincare. The biggest breakthroughs are going to be coming from your big companies, your L', Oreals, your P\u0026G's, your Unilever's, because they spend the most money on R D. And if I would be more convinced by a peptide if this was from Olay for example, than it is from some startup brand who I don't know, they stumbled onto some technology that the big guys didn't find. I'm just skeptical. Call it that. And also it's hard to notice differences when you're using any anti aging ingredient because it's going to take what, six weeks before you see anything. If you're going to see anything. And who remembers what their skin looked like six weeks ago?\"},{\"speaker\":\"A\",\"start\":2576.83,\"end\":2589.25,\"text\":\"Well, my skin looks drastic from day and night, which is actually a thing. There's some research papers on this by the way. I have one on my desktop right now. Well, you know, just because you're your day can really influence the way your skin looks.\"},{\"speaker\":\"B\",\"start\":2589.41,\"end\":2589.81,\"text\":\"Sure.\"},{\"speaker\":\"A\",\"start\":2589.89,\"end\":2606.61,\"text\":\"Especially at the end of it. Well, I thought, Perry, we could throw in a bonus question here because we have covered this topic in the past on the OS01 peptide and the One Skin brand. So here we have an alternate question. And guess what? You're going to be so happy with this.\"},{\"speaker\":\"B\",\"start\":2607.01,\"end\":2617.03,\"text\":\"I am. This person actually specifically requested that we do an AI voice and make it an Australian man. So let's do that now.\"},{\"speaker\":\"D\",\"start\":2617.43,\"end\":2642.57,\"text\":\"Hi Beauty Brains. I've been tempted by TikTok ads for a new barrier strengthening moisturizer from Experiment Beauty called Molecular Mesh. They rely heavily on videos from their cosmetic chemists to explain the special ingredients of the product. They especially highlight ectoin, phytosohenosine, glycerin, centella, liposomes and and Guaya zuleen. Thoughts? Thanks.\"},{\"speaker\":\"B\",\"start\":2643.13,\"end\":2648.41,\"text\":\"All right. Have you heard of this brand Experiment with the special molecular mesh?\"},{\"speaker\":\"A\",\"start\":2648.89,\"end\":2654.89,\"text\":\"I actually have heard of them and this is a very popular product right now. And for good reason.\"},{\"speaker\":\"B\",\"start\":2655.29,\"end\":2655.85,\"text\":\"I see.\"},{\"speaker\":\"A\",\"start\":2656.25,\"end\":2726.57,\"text\":\"For very good reason. One, I mean it looks gen looks very Gen Z or Gen Alpha. You know, it's bright colors, it's you know, blue on blue and yeah, um, you know it's just very grabby from that perspective. But they're using a lot of great language and key ingredients that are resonating with consumers right now. So everyone is about barrier strengthening, barrier repair. This is a barrier strengthening moisturizer, has a fun name, molecular mesh. You know, I don't really know what that means but they're using a couple ingredients that are buzzing right now. Primarily ectoin, which Sharon, or Sharon in the Australian accent, you know, highlighted phytosphingosine, which is actually a type of ceramide found within the stratum corneum of skin. Your stratum corneum, your outermost layer, has about 45% ceramide content. And then centella, specifically centella. Liposomes. Liposomes are also really hot right now, so I feel like they have a lot of sleep stuff going for them. And I would believe that this is a really great moisturizer.\"},{\"speaker\":\"B\",\"start\":2727.13,\"end\":2731.45,\"text\":\"So liposomes, ceramides, and amino acids.\"},{\"speaker\":\"A\",\"start\":2732.57,\"end\":2738.33,\"text\":\"Well, ectoin, they call it an amino acid, but it's not really an amino acid. Are you familiar with it?\"},{\"speaker\":\"B\",\"start\":2738.81,\"end\":2749.79,\"text\":\"Yeah, yeah. It's like. It's definitely not one of the 20amino acids that make up the proteins in human bodies, but I think it's some sort of derivative of amino acids. So it has the.\"},{\"speaker\":\"A\",\"start\":2750.11,\"end\":2799.44,\"text\":\"It has the carboxylic acid group, it has the amine group. So it has a similar structure, and they call it an amino acid. But that's actually a really great material. My favorite serum that I've been using this last year is actually an ectoin serum prototype from an ectoin supplier. So, yeah, I've been really impressed with this, with this molecule. But, yeah, just a really nice moisturizer. They have a lot of oils, like capryllo, capric triglyceride, safflower seed oil, and then they have a bunch of humectants, emollients, in it to make it feel really luxurious on skin. And then just, you know, with ceramides, you actually don't need a lot. They impart a really big oomph on skin. I'm talking, like, less than 0.1% in a formula. You would feel the impact of a ceramide.\"},{\"speaker\":\"B\",\"start\":2799.76,\"end\":2810.92,\"text\":\"It is interesting that she says that they rely heavily on their videos of their cosmetic chemists to explain their special ingredients. I mean, that's a marketing strategy, I guess.\"},{\"speaker\":\"A\",\"start\":2811.88,\"end\":2823.72,\"text\":\"Yeah, everyone likes to see that there's some brains behind the operation. So I think that's a really nice strategy that they've employed. But, you know, I don't think they need that. I think they have some great stuff.\"},{\"speaker\":\"B\",\"start\":2823.88,\"end\":2854.52,\"text\":\"Well, if you're going for, like, a sciencey story, which is what they're going for here, I could see that, that angle. It, you know, whenever you put, like, a lab coat on somebody, it makes what they're saying seem more legitimate, even if it's just marketing gobbledygook. But because the molecular mesh. What is. What is this? That's like, not science. That's just a marketing term. Well, looking at their founders, it does look like they do have chemistry backgrounds.\"},{\"speaker\":\"A\",\"start\":2855.24,\"end\":2866.71,\"text\":\"Yeah. I think one of them has worked in the industry a little bit. So that's kind of cool to see that there is a bit of real knowledge going into the product. Sometimes it's just like a. Well, you know, sometimes it's like a cover story, right?\"},{\"speaker\":\"B\",\"start\":2866.71,\"end\":2868.31,\"text\":\"Well, yeah, exactly.\"},{\"speaker\":\"A\",\"start\":2868.95,\"end\":2870.55,\"text\":\"This doesn't feel like a cover story.\"},{\"speaker\":\"B\",\"start\":2870.87,\"end\":2906.24,\"text\":\"Well, it's a huge challenge, in my opinion, for scientists to launch beauty products because so much of a beauty product success is based on the marketing and the marketing story that you can tell. And honestly, you kind of have to believe some BS to be able to, like, talk confidently. You get you to. When you're a scientist, you kind of have to be skeptical of things that you hear and read. And you're like, oh, this does that. And you're like, does it really? And while that makes for good science, it does not make for good selling and marketing. So that's what the big challenge is.\"},{\"speaker\":\"A\",\"start\":2906.4,\"end\":2931.53,\"text\":\"Exactly. Well, that's why I think they have done so well is because they have two co founders. One is more in the lab base and the other has a chemistry degree. But I don't think that they've worked on the chemistry side of our industry. So I think more of a beauty aficionado. So you have that person who can provide that hope in the bottle. But, yeah, it looks very fun and they're doing very well. And I'm sure it's a really great moisturizer.\"},{\"speaker\":\"B\",\"start\":2931.85,\"end\":2936.37,\"text\":\"Yeah. Well, those are our thoughts. And looks like we got time for.\"},{\"speaker\":\"A\",\"start\":2936.37,\"end\":2938.81,\"text\":\"One more comes to us from Jillian.\"},{\"speaker\":\"B\",\"start\":2939.13,\"end\":2978.33,\"text\":\"Jillian says this is for Valerie. Hello, and thank you so much for your wonderful podcast. I'm a new listener and soon to be Patreon supporter. Regarding the topic of rosacea, I did try scanning through the years of episodes to find ones, but no avail. How do you deal with rosacea? I'm contacting you specifically, Valerie, with this question because on a recent episode, I heard you mention that you deal with rosacea. And I'd like to pass on professional info on this topic to my stepson's girlfriend who deals with the condition. Thank you for your attention to my question. Oh, my God. Thank you for your attention this matter. Thanks so much, Jillian.\"},{\"speaker\":\"A\",\"start\":2980.65,\"end\":2986.61,\"text\":\"Well, we have talked about it before, but you're right. I guess it would be kind of hard to find because it's Right.\"},{\"speaker\":\"B\",\"start\":2986.61,\"end\":2986.85,\"text\":\"Right.\"},{\"speaker\":\"A\",\"start\":2986.85,\"end\":2987.45,\"text\":\"We don't.\"},{\"speaker\":\"B\",\"start\":2987.45,\"end\":2992.73,\"text\":\"We don't index our podcasts very well yet. Maybe we'll get some AI.\"},{\"speaker\":\"A\",\"start\":2992.81,\"end\":3019.23,\"text\":\"We should. Yeah. So I do struggle with rosacea. And actually when I was pregnant, which none of you guys knew about because I kept it a secret from everyone, even in the industry, I actually, for the first trimester and a half, suffered horribly from. I have pustular rosacea. And I just looked, like, horrible the whole time. It was a huge breakout all over my cheeks.\"},{\"speaker\":\"B\",\"start\":3019.23,\"end\":3020.35,\"text\":\"You didn't look horrible.\"},{\"speaker\":\"A\",\"start\":3020.51,\"end\":3022.03,\"text\":\"My nose, which is where I get it.\"},{\"speaker\":\"B\",\"start\":3022.56,\"end\":3023.12,\"text\":\"Yeah, I didn't.\"},{\"speaker\":\"A\",\"start\":3023.12,\"end\":3164.71,\"text\":\"Well, yeah. Well, thank you, Perry. Thank you. So, yeah, I really struggled with it, especially during the pregnancy, which is like, why couldn't I get cute symptoms? Right. That didn't impact my face. But anyway, so I have a prescription for this purpose. Azelaic acid, 15%, which is a prescription strength in the United States. And a lot of brands are jumping on the azelaic acid bandwagon because they just kind of blanket say it helps with rosacea, but that's not really the case. It specifically helps with pustular rosacea. And lightly. And I'm talking, like, it takes months exfoliating the surface of your skin. It's a very weak acid from this perspective. So. And you have to use a ton of it, obviously, 15% to get this result. And they don't really know how the mechanism works. So that's what I do. However, it depends what type of rosacea your stepson's girlfriend has. Has, because some rosacea just appears as, like, red, flushed skin or you have, like, a lot of small visible blood vessels. I don't have those per se, like, on my cheeks, but I have them on my nose. But I have the pustular type of rosacea, which looks like little pus dots all over my skin. And you can pop them like pimples. Although I don't recommend it, I do that anyway. And then some people have rosacea just, like, on their nose and think of, like, the classic old man who has, like, this really huge nose. And I think. I think it's called a bulb nose or something like that. It's very bulbous looking, and it just, like, has lots of capillaries and bumps and lumps on it. So the most important thing that your stepson's girlfriend can do is get diagnosed by a doctor. Yep. Stay away from products that can be irritating, like acids, retinoids, you know, all the good things that people want to put on their skin. She really just has to find out what makes it worse. It might not even be Topical skincare. That makes it worse. It might be like, things she's eating or stress, but there's definitely, like a trigger for it because rosacea is an inflammatory condition. So she'll have to figure out, like, what the triggers are and maybe even keep, like a little trigger diary. Like somebody who has migraines would keep a diary on what's triggering their migraines. You could do the same thing for rosacea, but it's important to get the type diagnosed and then get the correct care prescribed for that.\"},{\"speaker\":\"B\",\"start\":3165.11,\"end\":3189.96,\"text\":\"Yeah. The other things that are topical are anti inflammatories, you know, and not everything works for everyone. So an anti inflammatory, a topical might not work for somebody. So then they. There's oral medications that you get. But again, you know, we're not doctors, so I'm not gonna suggest any medication specifically. You go to a doctor. But those are the kinds of things that the doctor will suggest.\"},{\"speaker\":\"A\",\"start\":3190.76,\"end\":3195.64,\"text\":\"Exactly. So, Jillian, hopefully that helps your stepson's girlfriend. And thank you for your compliments on the show.\"},{\"speaker\":\"B\",\"start\":3196.76,\"end\":3199,\"text\":\"Speaking of show, do you hear that music?\"},{\"speaker\":\"A\",\"start\":3199.56,\"end\":3203.88,\"text\":\"I hear thunder, and that means I have to go before our Internet cuts out.\"},{\"speaker\":\"B\",\"start\":3203.88,\"end\":3208.92,\"text\":\"Wait, did. Did we change the music? The thunder and the lightning.\"},{\"speaker\":\"A\",\"start\":3209.24,\"end\":3218.29,\"text\":\"Oh, I hate that song. I was hoping you could put Thunderstruck on it, but we might get in trouble. But maybe not, because we actually don't generate ad revenue from this podcast.\"},{\"speaker\":\"B\",\"start\":3218.61,\"end\":3223.89,\"text\":\"Right, exactly. So YouTube will flag the ads and then nobody will get anything in it.\"},{\"speaker\":\"A\",\"start\":3223.89,\"end\":3233.25,\"text\":\"Do you think you could make AI version of Thunderstruck but for our show and so we don't get in trouble because that's the Dallas Cowboys cheerleader song.\"},{\"speaker\":\"B\",\"start\":3233.33,\"end\":3239.34,\"text\":\"Oh, is it? Wow, that's fun. Well, we'll see what happens. Wait till the end. End of the show and you might see it.\"},{\"speaker\":\"A\",\"start\":3239.34,\"end\":3246.62,\"text\":\"Oh, my gosh. Thanks for listening, everyone. If you get a chance, head over to Apple Podcasts or Spotify and leave us a review that's going to help other people Positive.\"},{\"speaker\":\"B\",\"start\":3246.62,\"end\":3248.94,\"text\":\"Find the show that we want Valerie to feel good.\"},{\"speaker\":\"A\",\"start\":3249.82,\"end\":3258.7,\"text\":\"Help my self esteem. I'm. I have postpartum stuff. I need an esteem boost that's going to help other people find the show and ensure we have a full docket of beauty questions to answer.\"},{\"speaker\":\"B\",\"start\":3259.1,\"end\":3280.469,\"text\":\"Speaking of questions, if you have a question, just record it on your smartphone and email it to the Beautybrains and you can get on the show with your voice. Or if you like the AI voices, just let us know what AI accent you want and we can put that on too. Or you can also use the form in the show notes of this episode.\"},{\"speaker\":\"A\",\"start\":3281.35,\"end\":3284.31,\"text\":\"Or our 1, 800 number. Has anyone else done that yet?\"},{\"speaker\":\"B\",\"start\":3284.95,\"end\":3295.37,\"text\":\"I have gotten some 1, 800 numbers. You can leave a voicemail with our number 872-216-1856.\"},{\"speaker\":\"A\",\"start\":3296.33,\"end\":3299.69,\"text\":\"Is this a number? I can also get a hold of you at if I need to tell you something.\"},{\"speaker\":\"B\",\"start\":3300.73,\"end\":3305.37,\"text\":\"No, I do not answer it, but if you do still leave a message, Yes, I will. I will see it.\"},{\"speaker\":\"A\",\"start\":3306.009,\"end\":3332.9,\"text\":\"The Beauty Brains are also on Patreon. You might have heard over the show we mentioned some of our listeners are patrons. This show is ad free. We do not have pesky ads. We are not corporate shills. And so we have to fund the show somehow. So we have a Patreon account and essentially the show is supported by our listeners like you. If you'd like to support the show at any level, you can head over to patreon.com forward/thebeautybrains and subscribe.\"},{\"speaker\":\"B\",\"start\":3333.46,\"end\":3342.39,\"text\":\"And you also get a transcript of the show. You get your questions a higher priority and on occasion we will do patronage only events.\"},{\"speaker\":\"A\",\"start\":3343.51,\"end\":3357.11,\"text\":\"Don't forget to follow us on our various social media accounts on Instagram where at the Beautybrains 2018 on X worth the Beauty Brains on Blue sky, we're at the Beauty Brains. We have a Facebook page, a TikTok and a YouTube channel at the BeautyBrains 2018.\"},{\"speaker\":\"B\",\"start\":3357.75,\"end\":3368.17,\"text\":\"Yeah, you can just listen to us on YouTube if you like to listen that way. And someday we might even show a little recording from our face to face here.\"},{\"speaker\":\"A\",\"start\":3368.89,\"end\":3370.57,\"text\":\"But not today because I look terrible.\"},{\"speaker\":\"B\",\"start\":3371.53,\"end\":3372.89,\"text\":\"Oh come on, you look great.\"},{\"speaker\":\"A\",\"start\":3373.29,\"end\":3377.37,\"text\":\"Thanks again for listening everyone. And remember, be brainy about your beauty.\"},{\"speaker\":\"B\",\"start\":3378.25,\"end\":3385.61,\"text\":\"Thanks everyone. Kittens.\"}]"])</script><script>self.__next_f.push([1,"47:T274c,"])</script><script>self.__next_f.push([1,"# The Beauty Brains – Episode 406  \n**Title:** Can Collagen Really Improve Skin \u0026 Why Is Purple Shampoo Drying?  \n**Date:** September 8, 2025  \n**Hosts:** Valerie George \u0026 Perry Romanowski  \n---\n\n## Overview\n\nIn episode 406, cosmetic chemists Valerie and Perry answer listener questions about the science behind trending beauty and hair care products. The episode unpacks hot topics like the effectiveness of collagen supplements, the drying effects of purple shampoo, new product reformulations, the regulatory status of mousse sunscreens, the OS01 peptide from OneSkin, molecular mesh moisturizers, and practical advice for dealing with rosacea. As always, the hosts bring expert analysis, skepticism on marketing claims, and a healthy dose of wit.\n\n---\n\n## Key Discussion Points \u0026 Insights\n\n### 1. **Collagen Supplements and Skin/Hair Health**  \n**[10:38 – 15:42]**\n\n- **Claims Addressed:**  \n  A report touts Peptan, a collagen peptide, as having “scientifically proven” benefits for skin density, elasticity, hydration, and possibly hair loss reduction.\n\n- **Skeptical Review:**  \n  - Perry is skeptical of collagen supplements:  \n    \u003e “I’m a collagen ingestion skeptic... what you eat is going to impact your skin in some specific way. I don't see extraordinary evidence for this being true.” (11:10)\n  - Valerie notes the lack of real mechanism evidence and that claims are “really suggestive in the language.” (13:35)\n\n- **Supplement Industry Critique:**  \n  - Perry criticizes the largely unregulated supplement industry:  \n    \u003e “People just don't need these things. If you're just eating a decent diet and you're taking care of yourself... it's all just kind of a waste of money in my mind.” (14:24)\n  - Valerie adds that most people don’t realize these are animal-derived products and discusses the various sources (fish, porcine, bovine). (15:21)\n\n### 2. **Are Product Renames Also Formula Changes?**  \n**[16:49 – 21:57]**\n\n- **Listener Question:**  \n  L'Oréal’s Elvive “Extraordinary Oil Rapid Reviver Power Conditioner” vs. the new “Total Repairs Power Restore.” Is it just a rename or a reformulation?\n\n- **Ingredient Comparison:**  \n  - Perry lays out that Power Restore actually introduces more conditioning agents and less oil compared to Rapid Reviver. There are differences in formula and performance. (18:43)\n  - Valerie explains that brands may rename and slightly tweak products for marketing, efficiency, or cost-saving reasons, not always for ingredient improvements. (19:54)\n\n### 3. **K18 and Brand Acquisitions**  \n**[22:02 – 27:54]**\n\n- **Listener Question:**  \n  Is K18 better as a Unilever brand? Are its products worth the hype?\n\n- **K18’s Technology:**  \n  - It’s a peptide-based bond builder, an alternative to Olaplex’s technology. (22:55)\n  - The brand was heavily marketed to salons and promptly acquired by Unilever.\n\n- **Chemists’ Take:**  \n  - Valerie: The molecular repair spray is solid, but shampoos/conditioners are \"not impressive\":  \n    \u003e “It’s pretty much like any other shampoo on the market with maybe this peptide tossed in... Go for their leave-in spray or mask.” (27:54)\n  - Perry: “You can’t really deliver much from a shampoo... it’s the sprays, the leave-on products where you're going to have the maximum effect.” (26:13)\n\n- **Brand Buyouts:**  \n  - Big companies often consolidate products and may eventually change the formulas to better match their portfolio, sometimes for efficiency, sometimes for improved performance. (25:32, 27:54)\n\n### 4. **Moose Sunscreens \u0026 FDA Regulations**  \n**[28:27 – 34:11]**\n\n- **Listener Question:**  \n  Why did the FDA warn companies about mousse-format sunscreens?\n\n- **Regulatory Perspective:**  \n  - Perry: Moose isn't an approved sunscreen format—FDA’s issue is about the specific vehicle, not efficacy. (28:47, 30:17)\n  - Valerie: Other fun formats (like wipes, powder) also aren’t technically allowed. High profile press likely triggered FDA enforcement. (29:05)\n  - Possible confusion with food-like packaging for children is also a concern. (32:18)\n\n- **Outcome:**  \n  - Companies may have to pull these from market or file for a New Drug Application (NDA), which is time-consuming and expensive. (33:33)\n  - Not a safety/effectiveness issue, but strictly a regulatory/formality issue.\n\n### 5. **Purple Shampoo: Why So Drying?**  \n**[34:19 – 40:41]**\n\n- **Listener (Emma, hairstylist):**  \n  Why do purple shampoos make hair feel drier?\n\n- **Chemist Explanation:**  \n  - Valerie: The key dye (Acid Violet 43) is negatively charged—this means no conditioning ingredients can be used because they’d interact and reduce efficacy.  \n    \u003e “Any purple shampoo product tends to be a really great cleansing shampoo and doesn’t impart any moisturizing or conditioning... minimalist formulations.” (38:18)\n  - The dye can also leave a coating on the hair surface, which might feel like dryness. (38:22)\n  - Perry: Most users already have dry hair (from bleaching), and the shampoo doesn’t add moisture, so it feels drier by comparison.  \n    \u003e “It might just be that your hair already is dry, but this shampoo is not doing anything to actually add moisture...” (39:25)\n  - Both: Mixing purple shampoo with conditioner is not effective; better to use a separate conditioner afterward. (39:25, 40:05)\n\n### 6. **OS01 Peptide from OneSkin**  \n**[40:48 – 43:09]**\n\n- **Listener:**  \n  What’s the real story behind OneSkin’s OS01 peptide?\n\n- **Expert Verdict:**  \n  - The hosts have addressed it before but reiterate their skepticism:  \n    \u003e “...very hard to have proof that peptides do anything, especially when the data comes from the brand.” (41:41)\n    \u003e “Biggest breakthroughs are going to be coming from your big companies, your L'Oréals, P\u0026G’s, Unilevers... I’d be more convinced by a peptide if this was from Olay.” (42:00)\n  - Any anti-aging improvement takes weeks and is hard to objectively measure.\n\n### 7. **Experiment Beauty “Molecular Mesh” Moisturizer**  \n**[43:27 – 48:51]**\n\n- **Listener “Sharon” (AI, Australian accent):**  \n  Is the new “Molecular Mesh” moisturizer from Experiment Beauty really special, or is the science just good marketing?\n\n- **Expert Analysis:**\n  - Valerie: The product is trendy, focuses on barrier strength, and uses ingredients like ectoin (a standout favorite for Valerie), phytosphingosine (a ceramide type), centella, glycerin, and liposomes. The formulation is “really nice”—high in emollients, effective even at low ceramide levels. (44:08–46:39)\n  - Perry: Most of the “science” is a strong marketing story.  \n    \u003e “Whenever you put a lab coat on somebody, it makes what they’re saying seem more legitimate, even if it’s just marketing gobbledygook... ‘molecular mesh’ is not science, just a marketing term.” (47:03)\n  - The brand does have founders with chemistry backgrounds, and the product likely works well as a moisturizer.\n\n### 8. **Rosacea – Skincare Advice \u0026 Treatment**  \n**[48:59 – 53:16]**\n\n- **Listener (Jillian):**  \n  Skincare routines and advice for dealing with rosacea.\n\n- **Valerie’s Personal Experience:**  \n  - Prescription azelaic acid 15% is standard for pustular rosacea (not the same as redness/flushing subtypes).\n  - Over-the-counter “azelaic acid” claims are often too weak to be effective.\n  - Valerie recommends formal diagnosis to determine rosacea subtype, careful avoidance of irritants (acids, retinoids), and tracking triggers (diet, lifestyle, skincare). (51:00–52:45)\n  - Perry adds that anti-inflammatories, sometimes oral prescriptions, are used under medical supervision, but specific recommendations should come from a doctor. (52:45)\n\n---\n\n## Notable Quotes \u0026 Moments\n\n- **On collagen skepticism:**  \n  \u003e \"I remain a collagen ingestion skeptic... that to me is an extraordinary claim, like in some specific way. And I don't see extraordinary evidence for this being true.\"  \n  — Perry [11:10]\n\n- **On purple shampoo dryness:**  \n  \u003e “Any purple shampoo product tends to be really just a really great cleansing shampoo and doesn't impart any moisturizing or conditioning... It’s not just like one, it’s like every single one. I've heard this complaint.”  \n  — Valerie [38:18]\n\n- **On supplement marketing:**  \n  \u003e \"I find the supplement industry a little bit unsavory... And it's just people just don't need these things. If you're eating a decent diet... it's all just kind of a waste of money in my mind.\"  \n  — Perry [14:24]\n\n- **On marketing vs. science:**  \n  \u003e “Whenever you put like a lab coat on somebody, it makes what they're saying seem more legitimate, even if it's just marketing gobbledygook.”  \n  — Perry [47:03]\n\n- **On rosacea diagnosis:**  \n  \u003e \"The most important thing... is get diagnosed by a doctor. Stay away from things that can be irritating... It's an inflammatory condition, so she'll have to figure out what the triggers are.\"  \n  — Valerie [52:00]\n\n---\n\n## Timestamps for Key Segments\n\n- **Collagen supplements discussion:**  [10:38 – 15:42]\n- **Product renaming/reformulation:** [16:49 – 21:57]\n- **K18 \u0026 Unilever acquisition:** [22:02 – 27:54]\n- **Mousse sunscreen \u0026 FDA:** [28:27 – 34:11]\n- **Purple shampoo dryness:** [34:19 – 40:41]\n- **OS01 peptide skepticism:** [40:48 – 43:09]\n- **Experiment Beauty Molecular Mesh:** [43:27 – 48:51]\n- **Rosacea management:** [48:59 – 53:16]\n\n---\n\n## Tone \u0026 Language\n\n- The hosts maintain a friendly, chatty, and sometimes irreverent tone while directly addressing listener questions.\n- They consistently advocate for scientific skepticism, pragmatic ingredient analysis, and push back against exaggerated marketing.\n- Product recommendations are grounded in chemist experience and ingredient data, not sponsored hype.\n\n---\n\n**For more details, reviews, and behind-the-scenes takes, visit The Beauty Brains online or check out their ad-free Patreon support.**\n\n---\n\n**Remember:**  \n**Be brainy about your beauty!**"])</script><script>self.__next_f.push([1,"3e:[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap items-center gap-3\",\"children\":[[\"$\",\"$L44\",null,{\"episodeData\":{\"uuid\":\"26c1993f-e751-4223-b8fe-c2f832c63483\",\"slug\":\"can-collagen-really-improve-skin-why-is-purple-shampoo-drying-episode-406\",\"name\":\"Can Collagen really improve skin \u0026 why is purple shampoo drying? - episode 406\",\"subtitle\":null,\"description\":\"$45\",\"imageUrl\":\"https://pod.wave.co/logo.png\",\"audioUrl\":\"https://www.buzzsprout.com/1192241/episodes/17803765-can-collagen-really-improve-skin-why-is-purple-shampoo-drying-episode-406.mp3\",\"duration\":3387,\"datePublished\":1757336400,\"transcript\":\"$46\",\"summary\":\"$47\",\"transcribeInProgress\":false,\"summaryInProgress\":false,\"podcastSeries\":{\"uuid\":\"b6877353-cd94-415f-91b1-16c1b6b62991\",\"name\":\"The Beauty Brains\",\"imageUrl\":\"https://storage.buzzsprout.com/bcflyq376wo0n1pk8h1tsvm3vk3s?.jpg\",\"authorName\":\"Discover the beauty and cosmetic products you should use and avoid\",\"itunesId\":733300242,\"datePublished\":1460437290,\"description\":\"Real scientists answer your beauty questions\",\"slug\":\"the-beauty-brains\",\"language\":\"en\"}}}],\"$L48\",\"$L49\",\"$L4a\"]}]\n3f:[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-2\",\"children\":[[\"$\",\"$L1b\",\"arts\",{\"href\":\"/genre/arts\",\"className\":\"inline-flex items-center rounded-wave-pill border border-[color:var(--border-1)] bg-[color:var(--bg-1)] px-3.5 py-1.5 text-[12px] font-medium text-[color:var(--fg-2)] transition-colors hover:border-[color:var(--fg-2)] hover:text-[color:var(--fg-1)]\",\"children\":\"Arts\"}],[\"$\",\"$L1b\",\"science\",{\"href\":\"/genre/science\",\"className\":\"inline-flex items-center rounded-wave-pill border border-[color:var(--border-1)] bg-[color:var(--bg-1)] px-3.5 py-1.5 text-[12px] font-medium text-[color:var(--fg-2)] transition-colors hover:border-[color:var(--fg-2)] hover:text-[color:var(--fg-1)]\",\"children\":\"Science\"}]]}]\n40:[\"$\",\"div\",null,{\"className\":\"mt-10\",\"children\":[\"$\",\"$L4b\",null,{\"seriesName\":\"The Beauty Brains\",\"seriesUrl\":\"/podcast/the-beauty-brains\"}]}]\n4e:T46c,What I saw here is that says they sort of hammer the science. Scientifically proven one or, you know, backed by science. And I don't know, I, I'm a collagen supplement skeptic because it's very difficult to prove that, oh, I've eaten this thing and it's had this effect on my skin, specifically because the way biology works is when you eat something, it goes into your stomach, it's broken down to these smaller peptides and then gets digested. So whether you're eating a collagen or you're eating fish or you're eating a hamburger, it all kind of gets turned into the kind of same stuff. Now, there are some who will say that, well, collagen gets turned into a peptide, that you don't find other types of food sources. And I mean, maybe that's true. Again, I'm. I find that a dubious claim that then it's going to go specifically to your skin and have effects. So, you know, I remain a collagen ingestion skeptic mostly because you make extraordinary claims like what you eat is going to impact your skin. That to me is an extraordinary claim, like in some specific way. And I don't see extraordinary evidence for this being true.4f:T603,"])</script><script>self.__next_f.push([1,"Right. Well, we, this happens a lot with any big brand. A big brand or big company will find a brand that is doing well and it's easier to buy up something that's already doing well than to develop a whole new brand yourself. You know, Unilever. There's nothing K18 did that Unilever couldn't have done. But Unilever has got to figure, well, it's just easier for us to buy you up and take, take the goodwill that's already been developed by your marketing on your own. So it's almost like small brands are like the minor leagues for brands until the big, until they get called up to the show, the big guys buy you. But what happens when a company buys you is that they try to consolidate things like manufacturing, marketing and R and D. And consolidate just means they shut you down and they make you move to Trumbull, Connecticut or something where Unilever is. Unilever bought out Helen Curtis, which used to make, in the Chicago area. They make salon selective swabs, all of those. And they bought them out and they, they were gonna develop a hair care research center in Chicago and that lasted for like 10 years. And they're like, nah, we won't do that. And so they shut them down and they moved everybody to east coast or everybody here in Chicago that they either had to find jobs or move. And that's kind of what happens when you buy, when a big company will buy another. So I don't know where K18 was originally located. They probably didn't have a lot of scientists behind this. I mean you wouldn't really need that many, right?"])</script><script>self.__next_f.push([1,"50:T46b,Sometimes when you have a key ingredient story, I actually think it can be detrimental to a hair brand. Yeah, I'll tell you why, Perry, because people think I have this One ingredient, I could just throw it in any shampoo and, or conditioner and it's going to really change the way the product works. And the reality is in hair care, an ingredient doesn't necessarily transform the shampoo, how the shampoo is put together. And it's not very easy to formulate shampoos or conditioners. I mean, sure, a lot of people can make them, they can't make really good ones. And so when you have to me like a subpar surfactant chassis and then you put this like key ingredient in it, you're just not going to see the results I think that you're, you're looking for. Because it's pretty much like any other shampoo on the market with you know, maybe this like peptide tossed in and two, they use in a couple of their shampoos. Just a surfactant combination that I'm not a really big fan of. So if you were going to try the K18 products, I would probably recommend their leave in molecular repair spray and their mask. Their mask is all right.51:T411,For very good reason. One, I mean it looks gen looks very Gen Z or Gen Alpha. You know, it's bright colors, it's you know, blue on blue and yeah, um, you know it's just very grabby from that perspective. But they're using a lot of great language and key ingredients that are resonating with consumers right now. So everyone is about barrier strengthening, barrier repair. This is a barrier strengthening moisturizer, has a fun name, molecular mesh. You know, I don't really know what that means but they're using a couple ingredients that are buzzing right now. Primarily ectoin, which Sharon, or Sharon in the Australian accent, you know, highlighted phytosphingosine, which is actually a type of ceramide found within the stratum corneum of skin. Your stratum corneum, your outermost layer, has about 45% ceramide content. And then centella, specifically centella. Liposomes. Liposomes are also really hot right now, so I feel like they have a lot of sleep stuff going for them. And I would believe that this is a really great moisturizer.52:T956,"])</script><script>self.__next_f.push([1,"Well, yeah. Well, thank you, Perry. Thank you. So, yeah, I really struggled with it, especially during the pregnancy, which is like, why couldn't I get cute symptoms? Right. That didn't impact my face. But anyway, so I have a prescription for this purpose. Azelaic acid, 15%, which is a prescription strength in the United States. And a lot of brands are jumping on the azelaic acid bandwagon because they just kind of blanket say it helps with rosacea, but that's not really the case. It specifically helps with pustular rosacea. And lightly. And I'm talking, like, it takes months exfoliating the surface of your skin. It's a very weak acid from this perspective. So. And you have to use a ton of it, obviously, 15% to get this result. And they don't really know how the mechanism works. So that's what I do. However, it depends what type of rosacea your stepson's girlfriend has. Has, because some rosacea just appears as, like, red, flushed skin or you have, like, a lot of small visible blood vessels. I don't have those per se, like, on my cheeks, but I have them on my nose. But I have the pustular type of rosacea, which looks like little pus dots all over my skin. And you can pop them like pimples. Although I don't recommend it, I do that anyway. And then some people have rosacea just, like, on their nose and think of, like, the classic old man who has, like, this really huge nose. And I think. I think it's called a bulb nose or something like that. It's very bulbous looking, and it just, like, has lots of capillaries and bumps and lumps on it. So the most important thing that your stepson's girlfriend can do is get diagnosed by a doctor. Yep. Stay away from products that can be irritating, like acids, retinoids, you know, all the good things that people want to put on their skin. She really just has to find out what makes it worse. It might not even be Topical skincare. That makes it worse. It might be like, things she's eating or stress, but there's definitely, like a trigger for it because rosacea is an inflammatory condition. So she'll have to figure out, like, what the triggers are and maybe even keep, like a little trigger diary. Like somebody who has migraines would keep a diary on what's triggering their migraines. You could do the same thing for rosacea, but it's important to get the type diagnosed and then get the correct care prescribed for that."])</script><script>self.__next_f.push([1,"41:[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-prose px-6 pt-14 pb-24 md:pt-16\",\"children\":[[\"$\",\"$24\",null,{\"fallback\":[\"$\",\"p\",null,{\"className\":\"font-mono text-[13px] uppercase tracking-[0.16em] text-[color:var(--fg-2)]\",\"children\":[\"$\",\"span\",null,{\"className\":\"wave-ellipsis\",\"children\":\"Loading summary\"}]}],\"children\":\"$L4c\"}],[\"$\",\"div\",null,{\"className\":\"mt-24\",\"children\":[\"$\",\"$L4d\",null,{\"segments\":[{\"speaker\":\"A\",\"start\":0.48,\"end\":26.32,\"text\":\"Hi, I'm Valerie, and you're listening to the Beauty Brains. Welcome to the Beauty Brains, a show where real cosmetic chemists answer your beauty product questions and give you an insider's look at the cosmetic industry. This is episode 406. I'm your host, Valerie George, and with me today is Perry Romanowski. Hi, Perry.\"},{\"speaker\":\"B\",\"start\":26.82,\"end\":28.58,\"text\":\"Hello, Valerie. Great to see you.\"},{\"speaker\":\"A\",\"start\":29.06,\"end\":53.37,\"text\":\"Great to see you. I'm so excited. We're back recording because we have so many questions to cover, including how can you tell if a new product is just a name change or did the formulas change? Why can't companies sell moose sunscreens? Why is purple shampoo drying on hair? What's the deal with the OS01 peptide? And how do you deal with rosacea? But first, that chit chat.\"},{\"speaker\":\"B\",\"start\":53.77,\"end\":55.37,\"text\":\"Valerie, it's good to see you up.\"},{\"speaker\":\"A\",\"start\":55.45,\"end\":58.65,\"text\":\"My shift started about seven hours ago at two in the morning.\"},{\"speaker\":\"B\",\"start\":58.81,\"end\":65.05,\"text\":\"You know, if you're getting up that early, you might as well also just get a cat too, because that's the time they like to get up to eat.\"},{\"speaker\":\"A\",\"start\":65.53,\"end\":83.54,\"text\":\"Well, pretty kitties. Kittens are out running about, and I'm trying to catch them, but it's just so hard now that I have baby C to get the traps and all that kind of stuff. But I should ask someone in the Dallas area to help out with that. But then Butch and Frank would go crazy.\"},{\"speaker\":\"B\",\"start\":84.74,\"end\":86.9,\"text\":\"You know, how have the dogs been with the baby?\"},{\"speaker\":\"A\",\"start\":87.54,\"end\":102.26,\"text\":\"You know, at first they were like, what is this? And then I think they had a little trauma in their past life with the baby because they got really upset when they saw the stroller. But they really like him now, mostly because they like to lick his vomit.\"},{\"speaker\":\"B\",\"start\":104.63,\"end\":107.35,\"text\":\"Well, I suppose there's a lot of protein in there for them.\"},{\"speaker\":\"A\",\"start\":107.35,\"end\":107.79,\"text\":\"Yeah.\"},{\"speaker\":\"B\",\"start\":107.79,\"end\":108.31,\"text\":\"Ew.\"},{\"speaker\":\"A\",\"start\":108.87,\"end\":118.87,\"text\":\"Well, remember last week we talked about Dr. Emmy skin? It was this German skincare brand by dermatologist Dr. Emmy Arpa. And I said it had Barbara Sturm vibes. Sure.\"},{\"speaker\":\"B\",\"start\":118.95,\"end\":120.15,\"text\":\"Episode 405.\"},{\"speaker\":\"A\",\"start\":120.23,\"end\":133.19,\"text\":\"Yeah, well, yeah, it was very recent. So I did order some products because I love the color yellow. And all I have to say is I better get my hat. So remember, they were offering this hat with UPF value or whatnot.\"},{\"speaker\":\"B\",\"start\":133.64,\"end\":136.36,\"text\":\"Right. The hat got you. I recall it did.\"},{\"speaker\":\"A\",\"start\":136.6,\"end\":174.25,\"text\":\"So I had. I placed an order. I didn't see the hat in the cart, but I saw the advertisement on the website. Like, you get your free hat if you place an order. And so I wrote them. All I have to say is that hat better come in the mail because if it doesn't, I have qualms. With them. Anyway, I wrote them and I said, please make sure the hat is in the package. I actually have to ship it to my cousin in Germany because it's been in the beauty news. I know we're not in beauty news yet, but a lot of people are upset that they can't get their cosmetic products from Europe shipped to them because the postal carriers aren't shipping to the US Right now.\"},{\"speaker\":\"B\",\"start\":174.65,\"end\":182.81,\"text\":\"Right. I did see in the news that countries around the world have all decided not to ship stuff to the US and that's because what, the tariffs and stuff?\"},{\"speaker\":\"A\",\"start\":182.89,\"end\":243.67,\"text\":\"Well, the tariff situation changed. So basically you had a de minimis exemption before, where if the value was under $800, it could enter duty free. The US is saying, well, you actually have to pay some tariffs on that. That's ending. And so these other countries aren't protesting the fact that US Citizens have to pay tariffs on package receipts or people in the US Receiving packages, But it's more or less like the process is unclear because U.S. customs hasn't come out with how they're going to calculate duties, pretty much. So they just did. They just stopped a little bit for a little bit. It'll pick back up again. It has nothing to do with, you know, anything, because other countries pay tariffs all the time and importing fees. Like, if you ship to Canada, you have to pay some fees when you get your package. Well, I'm gonna get my Emmy Arpa skincare. We'll just have to figure out how. Even if I have to go to Germany to get it, which I will be going to Germany, but I might have to wait to get it.\"},{\"speaker\":\"B\",\"start\":244.08,\"end\":245.52,\"text\":\"Yeah. When are you going to Germany?\"},{\"speaker\":\"A\",\"start\":246.56,\"end\":253.04,\"text\":\"Well, I was planning to go before in cosmetics in Paris next year, but I have to go sooner to get my skincare.\"},{\"speaker\":\"B\",\"start\":253.12,\"end\":261.92,\"text\":\"Oh, there you go. Well, you'll have to let us know how that goes. And I'll let you know, if there's anything you want me to pick up while I'm in France, you let me know.\"},{\"speaker\":\"A\",\"start\":262.48,\"end\":267.44,\"text\":\"Ooh, great idea. Anything happen with you in the last week?\"},{\"speaker\":\"B\",\"start\":267.68,\"end\":270.64,\"text\":\"I went golfing yesterday at, like, seven in the morning.\"},{\"speaker\":\"A\",\"start\":271.46,\"end\":272.66,\"text\":\"Did you wear your sunscreen?\"},{\"speaker\":\"B\",\"start\":273.06,\"end\":283.02,\"text\":\"You know I did not. Because I wore long sleeves and long pants. Because you know what? It's the end of August and it's cold. Like, how is it cold in the end of August in Chicago?\"},{\"speaker\":\"A\",\"start\":283.02,\"end\":287.3,\"text\":\"This is Chicago. I'll trade you places. It is still so hot here in Texas.\"},{\"speaker\":\"B\",\"start\":287.3,\"end\":287.78,\"text\":\"Oh, really?\"},{\"speaker\":\"A\",\"start\":288.18,\"end\":292.26,\"text\":\"Oh, my gosh. But I have a question. Weren't you worried about exposing your neck and Face.\"},{\"speaker\":\"B\",\"start\":293.14,\"end\":295.38,\"text\":\"I mean, I wear a hat also.\"},{\"speaker\":\"A\",\"start\":295.94,\"end\":298.58,\"text\":\"And is it a wide brim hat or a baseball hat?\"},{\"speaker\":\"B\",\"start\":298.76,\"end\":303.08,\"text\":\"It's a. It's a golf hat. It's a very stylish golf hat.\"},{\"speaker\":\"A\",\"start\":303.08,\"end\":304.12,\"text\":\"What's a golf hat?\"},{\"speaker\":\"B\",\"start\":304.28,\"end\":307.12,\"text\":\"It's like a old timer, but it's.\"},{\"speaker\":\"A\",\"start\":307.12,\"end\":313.4,\"text\":\"Similar to a baseball hat. Oh, yes, yes, yes. No, it is not similar to a baseball hat. Oh, it's similar.\"},{\"speaker\":\"B\",\"start\":313.4,\"end\":314.44,\"text\":\"It has like a rib.\"},{\"speaker\":\"A\",\"start\":314.92,\"end\":317,\"text\":\"I don't know, it goes on your head. It's similar.\"},{\"speaker\":\"B\",\"start\":317.4,\"end\":319.12,\"text\":\"It is very similar.\"},{\"speaker\":\"A\",\"start\":319.12,\"end\":319.88,\"text\":\"Oh, goodness.\"},{\"speaker\":\"B\",\"start\":320.04,\"end\":330.49,\"text\":\"Well, you know, that's such a frustrating sport, though, because, like, I play it all the time and I never get better. I never get worse, but I never get better. And it's like you spend all this time, you should get better at something. But I don't.\"},{\"speaker\":\"A\",\"start\":330.97,\"end\":335.85,\"text\":\"That's usually how it goes. So it's. Oh, well, golf is difficult.\"},{\"speaker\":\"B\",\"start\":336.17,\"end\":341.369,\"text\":\"It is. Well, yeah, for some people. For me, obviously, although I have high expectations.\"},{\"speaker\":\"A\",\"start\":341.69,\"end\":346.49,\"text\":\"Well, it hasn't been a difficult week in beauty news. It actually was pretty light. So let's head over there.\"},{\"speaker\":\"B\",\"start\":351.37,\"end\":369.23,\"text\":\"Valerie, my old brand was in the news. I saw this article about which. Which tickled me. It's like from glam. They said, we tried V5 shampoo and its plumping effect vastly outshines Pantene's viral comeback.\"},{\"speaker\":\"A\",\"start\":370.19,\"end\":374.67,\"text\":\"Well, they're two completely different shampoos, so how could you even compare them?\"},{\"speaker\":\"B\",\"start\":375.31,\"end\":393.65,\"text\":\"Well, I mean, they are all just about the claims, right? And so brands like Pantene, they say, have been like the go to and they get a lot of press on the Internet, I guess, because, you know, P and G is very good at, well, advertising.\"},{\"speaker\":\"A\",\"start\":393.81,\"end\":396.29,\"text\":\"They spend a lot, especially their flagship.\"},{\"speaker\":\"B\",\"start\":396.29,\"end\":443.78,\"text\":\"Shampoo for sure, which has been the number one shampoo in the United States since at least 2000. Well, I've seen this complaint about Pantene a lot. People say, oh, it leaves a residue on your hair. So some, you know, some people would wrongly say, oh, it's leaving plastic on your hair, but it does leave a film on your hair. And this person used it and she says for her curly hair and it wasn't quite right. But then she said VO5 caught my attention, thanks to the scents and the benefits of ranging from moisturizing to clarifying and revitalizing. Oh, my God. And she said, I tried it and it worked better for my hair than Pantene.\"},{\"speaker\":\"A\",\"start\":444.26,\"end\":469.14,\"text\":\"I bet you. I mean, a VO5 works, but it's just different than Pantene. Right. So I just don't feel like you could even compare them. And I also wonder if VO5 caught their eye because, like, the early 90s are back in, and the early 2000s are back in. And so it's like, oh, let me just look at these, like, drugstore shampoos. Because that's where people get them, right?\"},{\"speaker\":\"B\",\"start\":469.14,\"end\":487.74,\"text\":\"Well, I think the beauty of VO5, I mean, it's the cost, of course, but they do a good job with bright colors and lots of fragrance. And so if you like that kind of thing, that was very popular, like Bath and Body Works is very popular in malls and stuff.\"},{\"speaker\":\"A\",\"start\":487.74,\"end\":495.55,\"text\":\"And that's what I'm saying. It's back in. It's just trending. In two years, people won't care about VO5 again.\"},{\"speaker\":\"B\",\"start\":496.35,\"end\":503.71,\"text\":\"No, VO5 has been around since the 1950s. It's never going away. I mean, it's never gonna be fine with it.\"},{\"speaker\":\"A\",\"start\":504.189,\"end\":507.95,\"text\":\"It's not gonna be in glam.com ever again. That's what I'm saying.\"},{\"speaker\":\"B\",\"start\":508.67,\"end\":532.18,\"text\":\"Well, until the next zillennial or whatever the next generation is, they discover the old timer and like, hey, because I think, like, 99 cent shampoo. Well, I guess it's not 99 cents anymore. It's probably $1.59 or something. Cheap shampoos are never going to go away. There's always going to be the basic Bobs and the basic Betty's, as we call them in marketing research, who want these kinds of products.\"},{\"speaker\":\"A\",\"start\":533.3,\"end\":541.06,\"text\":\"Well, I did recommend some inexpensive shampoos to the arborists that came to our home to take care of some of our mulberry trees.\"},{\"speaker\":\"B\",\"start\":541.14,\"end\":542.66,\"text\":\"And for the trees.\"},{\"speaker\":\"A\",\"start\":543.69,\"end\":553.29,\"text\":\"Well, for himself selling the treatment, he took his hat off. He took his hat off and said, can you recommend, like, what shampoo should I be buying? And I just said, honestly, the cheapest.\"},{\"speaker\":\"B\",\"start\":553.69,\"end\":556.57,\"text\":\"All right, so get him. Get him VO5 or Suave.\"},{\"speaker\":\"A\",\"start\":557.45,\"end\":558.57,\"text\":\"That's what I recommended.\"},{\"speaker\":\"B\",\"start\":558.81,\"end\":565.69,\"text\":\"You know, when I was on VO5, there was Suave, and then there was another cheap shampoo called White Rain.\"},{\"speaker\":\"A\",\"start\":567.13,\"end\":579.3,\"text\":\"The White Rain. What White Rain is gone. But they had this hairspray. It was in the green. White Rain was a white package for the most part. And it had, like, an accent color on it.\"},{\"speaker\":\"B\",\"start\":579.54,\"end\":579.98,\"text\":\"Okay.\"},{\"speaker\":\"A\",\"start\":579.98,\"end\":607.38,\"text\":\"And there was a White Rain hairspray that was. Had the green cap and, like, the green raindrop on it. Oh, the first napkin smelled so good that we would just. My friend had it and we would just spray it in her house as, like, air freshener because it smelled so good. I remember the scent, and sometimes I'm like, what happened to that? That's so funny. I Just thought about that the other day.\"},{\"speaker\":\"B\",\"start\":607.62,\"end\":609.3,\"text\":\"It was owned by Gillette.\"},{\"speaker\":\"A\",\"start\":609.7,\"end\":610.34,\"text\":\"Okay.\"},{\"speaker\":\"B\",\"start\":610.5,\"end\":613.62,\"text\":\"And then Gillette got bought by, I think, P and G, right?\"},{\"speaker\":\"A\",\"start\":614.58,\"end\":618.5,\"text\":\"No, did Gillette get bought by Comb or P and G?\"},{\"speaker\":\"B\",\"start\":618.98,\"end\":620.5,\"text\":\"I thought it was P and G.\"},{\"speaker\":\"A\",\"start\":620.5,\"end\":622.7,\"text\":\"Yeah, it's probably P and G. Yeah.\"},{\"speaker\":\"B\",\"start\":622.77,\"end\":627.97,\"text\":\"Yeah. So. And then P and G doesn't want small brands like that or Procter and Gamble.\"},{\"speaker\":\"A\",\"start\":627.97,\"end\":630.41,\"text\":\"Is P and G everybody. Industry vernacular.\"},{\"speaker\":\"B\",\"start\":630.41,\"end\":636.13,\"text\":\"Oh, that's right. I think P and G is out in the. It's out in the public world.\"},{\"speaker\":\"A\",\"start\":636.13,\"end\":637.81,\"text\":\"Png it might be, yeah.\"},{\"speaker\":\"B\",\"start\":638.05,\"end\":638.53,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":638.53,\"end\":669.82,\"text\":\"Well, I saw something that I thought would really stick in your craw. Do collagen supplements really improve skin? It was an article in Cosmetics business and it's about this, I guess, peptide or collagen called Peptan. I felt like. Yeah, felt like a paid spot of sorts in this news website, we'll call it. But basically it's a collagen peptide that you consume and they have some benefits for skin and hair.\"},{\"speaker\":\"B\",\"start\":670.86,\"end\":759.46,\"text\":\"$4e\"},{\"speaker\":\"A\",\"start\":760.5,\"end\":814.23,\"text\":\"They didn't go into the science behind the collagen peptide. Like how is it different than other collagen or other peptides? But they do claim it has high bioavailability, which means your body absorbs more of it than it ordinarily would, presumably due to the peptide sequence. Maybe. But again, they don't go into that. They just go into their two clinical trials that show it improves skin density, elasticity and hydration while also reducing wrinkle visibility. Again, really hard to do from the inside out. Then they did a study where peptan stimulated the number of active stem cells and hair follicles to slow their decline. They don't have any proof that it does anything for hair loss, but it suggests a pro promising approach to counteract age related hair loss. So it's just really suggestive in the language and I'm just not sure that it would do that.\"},{\"speaker\":\"B\",\"start\":815.19,\"end\":834.18,\"text\":\"Again, they're implying these incredible claims, oh, here, eat this and your hair will fall out less slowly. Okay. I mean, that would be great if that were true. Let's prove it more than just like, oh, you know, we saw in a lab that, oh, this could happen.\"},{\"speaker\":\"A\",\"start\":834.26,\"end\":863.95,\"text\":\"Like, come on, you know, I'm not against, like consuming collagen, like vital collagen or whatnot, because if, you know, you're still consuming something that's beneficial. And I actually don't have a high protein diet. I actually don't think most people eat enough protein. But, you know, if it doesn't hurt, it, you know, doesn't hurt. Yeah, but I just don't like the way vital collagens taste. You know, like people are putting it in their coffee and it's like, this stuff tastes awful. I wonder if this is better.\"},{\"speaker\":\"B\",\"start\":864.51,\"end\":920.13,\"text\":\"Yeah, I just find that people are not skeptical enough of supplements in general, and this kind of thing just sort of boosts the supplement industry. I find the supplement industry a little bit unsavory, as it were, because pretty much it's unregulated here in the United States. And they can make all kinds of claims they want. And, you know, I know there's hugely popular podcasts that sell supplements. That's how they make a lot of money. And it's just people just don't need these things. If you're just eating a decent diet and you're taking care of yourself. I mean, you don't need to supplement with stuff like vitamins and ginkgo biloba and all this. It's all just kind of a waste of money in my mind. So maybe that bias is my view of the science behind eating collagen for your skin. I don't know.\"},{\"speaker\":\"A\",\"start\":921.41,\"end\":942.61,\"text\":\"Yeah, it's. It's very interesting. I'm reading about the manufacturer of the peptide from this peptan manufacturer, and they have a porcine version, a bovine version, a fish version, a lot of collagen does come from fish, which can explain some of the taste. But usually collagen has to come from some kind of animal source.\"},{\"speaker\":\"B\",\"start\":942.85,\"end\":950.97,\"text\":\"Right. It is surprising to me that people aren't worried about the animal derivation of collagen.\"},{\"speaker\":\"A\",\"start\":952.01,\"end\":956.89,\"text\":\"I wonder if they think about it. I don't think people think like, well, where is this collagen coming from?\"},{\"speaker\":\"B\",\"start\":957.05,\"end\":969.11,\"text\":\"Well, I mean, they think about their beauty products and like, oh, are there animal ingredients in it? And that is a big turn off. But I guess eating animals is different than using them for cosmetics.\"},{\"speaker\":\"A\",\"start\":970.22,\"end\":980.62,\"text\":\"My mentor who passed away always lamented how he missed the days where he could use beef collagen in hair because he just said it. It made the hair feel really soft and hydrated.\"},{\"speaker\":\"B\",\"start\":981.9,\"end\":991.1,\"text\":\"Well, and you know, the thing is that was not. Nobody went out and killed animals so they could put it in their cosmetics. That was just a byproduct of the meat industry.\"},{\"speaker\":\"A\",\"start\":991.58,\"end\":994.3,\"text\":\"Yeah, very true. It's the original upcycling.\"},{\"speaker\":\"B\",\"start\":994.85,\"end\":996.13,\"text\":\"That's right. It's upcycling.\"},{\"speaker\":\"A\",\"start\":996.93,\"end\":1008.13,\"text\":\"Well, what we're not upcycling is these questions. They're all brand new. Our first question comes to us from Laura, a patron.\"},{\"speaker\":\"B\",\"start\":1009.41,\"end\":1071.57,\"text\":\"Laura says, hi, beauty brains. Happy summer. Two quick questions regarding hair care. And since she is a patron, we don't mind. Two quick questions. All right. She says, I have long, light brown colored hair with black blonde highlights and it is very dry. Previously I used and liked l' Oreal Elvive Extraordinary Oil Rapid Reviver Power Conditioner. Wow. L'. Oreal. Thanks for the very long names. However, it seems it was discontinued and replaced with the l' Oreal Elvive Total Repairs Power Restored for damaged hair. Would you know if this is true? I do like the power restore too, but they seem a little different. All right. It's not uncommon, I guess, for a company to replace one line with another. It sort of streamlines things and it. I guess it makes production easier and more efficient. But what happens usually when they do replace stuff like that?\"},{\"speaker\":\"A\",\"start\":1072.05,\"end\":1122.38,\"text\":\"Well, this might not be a. A total renaming project. I mean, it might be if the l' Oreal has discovered that maybe the product's not doing as well as they thought it would and they don't perceive it to be a formulation issue and it could be a naming and product positioning issue for sure. They could have just changed the name, maybe highlighted some different product attributes, but it seems that maybe it was a reformulation and maybe the product wasn't doing great. And they said, well, why not change the name to something different? Change a Couple bells and whistles. Or maybe they just kept the same formula and tweaked a little key ingredient. That's fairy dust in the formula. It's really hard to tell. Were you able to find the ingredient list and compare them, Perry?\"},{\"speaker\":\"B\",\"start\":1123.1,\"end\":1194.13,\"text\":\"Yeah, the oil rapid Reviver, the main ingredient is amodimethicone. Up front, it's. And behem Trimonium chloride. So those are, those are the two main ones there. And for the power restore, we've got dimethicone and behem Trimonium chloride. And it also has a lower level of amodimethicone and C. Tronium chloride also. So the new one seems like it's got a few more conditioning ingredients, but kind of the same ones. Like it has amodimethicone and behentra ammonium chloride, which is, you know, the same as the. The first one, but then it has some additional ones in it. So I think as far as formulations, I could see why she might find differences because they're not exactly the same. The first one had also has camellia oleifera seed oil. So it's going to have a little more oil incorporated into it, whereas the. The new one doesn't really have any of the oils in it.\"},{\"speaker\":\"A\",\"start\":1194.61,\"end\":1211.9,\"text\":\"Well, it makes sense. The first one was an oil in the name Rapid Reviver, whereas the new one is more about power restore and repair. So presumably more conditioning agents makes a little sense. So sounds like it maybe wasn't a reformulation, but a different formulation.\"},{\"speaker\":\"B\",\"start\":1212.7,\"end\":1225.42,\"text\":\"Right. So for whatever reason, they replaced this one that you used to like with something new. And it's probably because not enough people were buying the one that they replaced.\"},{\"speaker\":\"A\",\"start\":1225.82,\"end\":1232.94,\"text\":\"Yeah, that's true. Or, you know, oils are inexpensive until the crop goes bad. Right?\"},{\"speaker\":\"B\",\"start\":1232.94,\"end\":1233.3,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":1233.3,\"end\":1248.7,\"text\":\"So then they say, well, we need something that's maybe not dependent on crops. And. And so they could have done it for cost cutting measures as well. Or maybe they didn't make the formula themselves and they wanted to produce something that they make on their own.\"},{\"speaker\":\"B\",\"start\":1249.42,\"end\":1270.02,\"text\":\"That's right, because l' Oreal will. First they buy a bunch of brands and they also use contract manufacturers. So usually I would imagine, though, a company like l' Oreal, as a contract manufacturer, they're going to own their formulas. But if they bought a company, they might not necessarily own that formula.\"},{\"speaker\":\"A\",\"start\":1270.34,\"end\":1302.75,\"text\":\"Well, that's not necessarily the case, Perry. Just a few weeks ago we talked about Urban Decay, which is a l' Oreal owned brand, and the contract manufacturer that used to make that setting spray. L' Oreal pulled that business, launched Their own version of it. And the manufacturer who invented this best selling setting spray has been very public about the separation. So yeah, it's totally possible that a contract manufacturer was making this extraordinary oil rapid reviver for them.\"},{\"speaker\":\"B\",\"start\":1303.55,\"end\":1317.15,\"text\":\"Yeah, yeah. No, you, you are correct. All right, well that's that. And you know, I hope you. I mean they still use the main conditioning ingredients of amodimethicone and behem trimonium chloride. So I think you're going to get a lot of the same benefits.\"},{\"speaker\":\"A\",\"start\":1317.55,\"end\":1322.27,\"text\":\"Similar. Slightly different. Yeah. Well, Laura had a second question. What was it said?\"},{\"speaker\":\"B\",\"start\":1322.27,\"end\":1347.99,\"text\":\"Recently my stylist used K18 shampoo and conditioner on my hair. I've never heard of it and see it is a Unilever brand. Any comments on that line? My stylist was sold and assured me it was the best thing for my bleached dry hair. Please share your thoughts and we. I appreciate all you do, Laura. Wow. K18, she hasn't heard of it. She must not be on social media because that was everywhere, right?\"},{\"speaker\":\"A\",\"start\":1348.19,\"end\":1375.33,\"text\":\"Oh my gosh. Especially in the salon professional circles for sure. So K18 is a new Unilever brand. It was actually just acquired within the last couple years at 3 years old. An insane amount of money for it. And we'll talk about what happens as a Unilever brand in a second. But it was an independent brand before that and a lot of people are hooked on it. They did a great job getting their first foot in the door of salons.\"},{\"speaker\":\"B\",\"start\":1375.65,\"end\":1412.17,\"text\":\"Essentially what it is is one of these bond builders. Olaplex was the first popular one and that was based on some mercaptan chemical technology or something like that. K18, their bond builders are based on peptides. So they create this peptide that's supposed to build bonds and hair and make your hair better. And then they did a heck of a marketing job on salons and they built built their K18 as the alternative to Olaplex and you know, did did quite well. Well enough to get the attention of Unilever who just bought them right up.\"},{\"speaker\":\"A\",\"start\":1413.21,\"end\":1427.93,\"text\":\"So what happens when a company buys a another brand? So I know that you worked at Alberto Culver that was bought by Unilever and I've heard from some ex Alberto employees, not you, that it was Uniqleiver bought them.\"},{\"speaker\":\"B\",\"start\":1428.17,\"end\":1531.17,\"text\":\"$4f\"},{\"speaker\":\"A\",\"start\":1532.13,\"end\":1572.36,\"text\":\"No. A brand like this is, you know, probably using contract manufacturers and, and whatnot because it's very rare. Yes, they had this ingredient developed, but not many brands starting out have their own facilities. I would say that's pretty, pretty rare. Now the products themselves are all right. So I used to work at a salon brand. We've tested everything K18. And you know, the, the spray is really what put them on the map. It's this spray that contains a concentrated level of this pest peptide that they have. And that's a really fine product. But the shampoos and conditioners, I mean I, I'm not impressed.\"},{\"speaker\":\"B\",\"start\":1573.24,\"end\":1595.27,\"text\":\"Well, also they're rinse out, right? So you can't really deliver much from a shampoo. So when you, these bond builders, they're just washing out from a shampoo mostly a conditioner maybe can get a little bit more delivery. But it's really the sprays, the leave on products where you're going to have the maximum effect of the, these bond builders.\"},{\"speaker\":\"A\",\"start\":1596.39,\"end\":1673.62,\"text\":\"$50\"},{\"speaker\":\"B\",\"start\":1674.34,\"end\":1707.16,\"text\":\"Yeah. And as far as the, when the big company bought them, they probably change the formulas. They will, they'll change the formulas eventually. So that would probably, you know, Unilever has some good shampoo formulas. I mean they have Tresemme now that they took from us now, but you know, that's a good performing shampoo. So I could totally see them adapting one of their more consumer liked formulas to the K18 technology. And maybe people like the shampoo better. I don't know.\"},{\"speaker\":\"A\",\"start\":1707.24,\"end\":1726.84,\"text\":\"We'll see. Our second question comes to us from Misty, also a patron. Hi beauty brains. I saw the FDA issued a warning letter to companies like Supergoop and Vacation that make Moose sunscreens. The language is really confusing. Is it because mousse has not been studied and approved by the FDA as a format?\"},{\"speaker\":\"B\",\"start\":1727.81,\"end\":1744.85,\"text\":\"Well, this is a great question, Misty, and yes, you're right. I mean it's probably been studied but Moose has not been approved by the FDA as a format. And so that is specifically why these companies got that letter.\"},{\"speaker\":\"A\",\"start\":1745.57,\"end\":1775.44,\"text\":\"It's interesting because they've actually had this mousse format sunscreen out for a while and other supergoop has other brands have as well. There's tons of brands that have sunscreens in powder format or wipe format which are also not allowed formats. And people have wondered, oh, why is the FDA spending resources on this now? And I actually think it was because Wall Street Journal had a huge article on vacation and how they've made sunscreen. Fun again.\"},{\"speaker\":\"B\",\"start\":1775.84,\"end\":1776.32,\"text\":\"Yeah.\"},{\"speaker\":\"A\",\"start\":1776.32,\"end\":1816.43,\"text\":\"And there's nothing more than a government hates than the word fun. So I'm sure that quickly got the attention of the FDA and said sunscreens cannot be fun. And so they've. I don't know why I said that in a pseudo Arnold Schwarzenegger voice. But anyway, they said, whoa, let's stop making this fun, because mousse is not an approved format. Although if I were a lawyer on this case for the brands, I would say isn't technically mousse lotion with temporary air placed inside. Theoretically, once it's put onto the skin, the air volatilizes and that becomes, once again, lotion.\"},{\"speaker\":\"B\",\"start\":1817.07,\"end\":1857.13,\"text\":\"You know, they should hire you as an expert witness. Yeah. You know, I think the important thing to know here, too, is just because the FDA called these companies out, that doesn't mean the moose form isn't an effective sunscreen. I'm sure if they put SPF on their thing, they probably went and did SPF testing using the mousse and using the levels that you're supposed to use, and they showed that it was working the way they say it is. But the FDA just says, hey, it's not an approved format, so you can't do that. So it's not about does it work or not.\"},{\"speaker\":\"A\",\"start\":1858.25,\"end\":1868.3,\"text\":\"Now, could the brands petition the FDA to make this an approved format through some kind of not new drug application? Because it's not necessarily a new drug active.\"},{\"speaker\":\"B\",\"start\":1868.3,\"end\":1891.42,\"text\":\"But no, they could submit a new drug application, an NDA, and the FDA could approve that, but you have to do that on every formula. So you, you, you couldn't just do that. Oh, on this mousse in general, and then you can make a bunch of different formulas. No, you have to make the same formula. And so that's why NDAs are not done very often with something like a sunscreen.\"},{\"speaker\":\"A\",\"start\":1891.74,\"end\":1905.42,\"text\":\"Well, if I were vacation, I would do it because this formula is pretty good. Yeah, mostly it's the fragrance, I'm not going to lie. Also, I do generally like mousse formats because I think foam in the hand is really fun, but I'm not.\"},{\"speaker\":\"B\",\"start\":1905.42,\"end\":1914.92,\"text\":\"I've not used the mousse as a sunscreen. Is it easy to apply? I don't think it would seem like it would be a little sticky, you know.\"},{\"speaker\":\"A\",\"start\":1914.92,\"end\":1930.6,\"text\":\"Yeah. But again, I think it's about it being different. It's fun. You know, I'm a foam hand sanitizer, a foam hand soap kind of girl. So, yeah, you know, for me, that doesn't bother me. It's. No, no, different than any other, you know.\"},{\"speaker\":\"B\",\"start\":1931,\"end\":1931.4,\"text\":\"Sure.\"},{\"speaker\":\"A\",\"start\":1931.48,\"end\":1933.4,\"text\":\"Sunscreen in that type of sense.\"},{\"speaker\":\"B\",\"start\":1933.56,\"end\":1934.44,\"text\":\"Right, right, right.\"},{\"speaker\":\"A\",\"start\":1934.84,\"end\":1935.24,\"text\":\"Yeah.\"},{\"speaker\":\"B\",\"start\":1935.24,\"end\":1937.56,\"text\":\"I suppose it doesn't have to be sticky either.\"},{\"speaker\":\"A\",\"start\":1938.28,\"end\":1954.31,\"text\":\"No. The only other thing is, I think I feel like they also got reprimanded a little bit because one thing you can't do is have cosmetic products look like food without some kind of warning, or you have to specifically say they're not for kids.\"},{\"speaker\":\"B\",\"start\":1954.79,\"end\":1955.11,\"text\":\"Right.\"},{\"speaker\":\"A\",\"start\":1955.11,\"end\":1978.43,\"text\":\"I think because children's products, even like children's cosmetic products are regulated in that sense where it can't look like it's edible, it's in a whipped cream package like you would get at the grocery store. It just has whip in the hand. I mean, it looks like it could be a food. Food item. And so I. I feel like I recall someone saying that was also an issue.\"},{\"speaker\":\"B\",\"start\":1978.99,\"end\":2006.35,\"text\":\"That. Yeah, that's probably correct. So I think the bottom line here is that it's not about whether it's been studied or not. It, you know, I'm sure it's studied and you can make effective SPF with a moose version. It's just not approved by the fda. And, you know, they're slow to approve stuff. In fact, I thought sprays for the. For a long time, sprays were not really legal, but somehow they got approved eventually.\"},{\"speaker\":\"A\",\"start\":2006.91,\"end\":2012.35,\"text\":\"Yeah. So what happens? Do they have to pull it from the market? Like, what's the outcome?\"},{\"speaker\":\"B\",\"start\":2013.47,\"end\":2022.15,\"text\":\"Yeah, I think they will have to either pull it from the market or they're going to have to fill out the application. Yes, do it. Do an NDA.\"},{\"speaker\":\"A\",\"start\":2022.15,\"end\":2029.31,\"text\":\"So, well, get the vacation Moose sunscreen while you can. I still see it's on the Ulta website, and so I'll pick a couple up.\"},{\"speaker\":\"B\",\"start\":2029.76,\"end\":2042.6,\"text\":\"There's a brand like Kalani Sunwear. They've already pulled their mousse sunscreens from the US Website. So some people are already reacting to this being preemptive. They are.\"},{\"speaker\":\"A\",\"start\":2042.6,\"end\":2047.92,\"text\":\"Is preemptive the word preemptive? Yeah, they're. They're being precautionary.\"},{\"speaker\":\"B\",\"start\":2048.24,\"end\":2050.96,\"text\":\"Yeah, sure. I think preemptive works there.\"},{\"speaker\":\"A\",\"start\":2051.28,\"end\":2053.12,\"text\":\"I don't know. I wasn't an English major.\"},{\"speaker\":\"B\",\"start\":2053.6,\"end\":2058.96,\"text\":\"You know what works also is this audio question that we have. Let me. Let me cue that up.\"},{\"speaker\":\"C\",\"start\":2059.6,\"end\":2092.98,\"text\":\"Hi, beauty brains. My name is Emma and I'm a hairstylist. And I have a question about purple shampoo and why it's so drying. One of the things that my clients complain to me the most about purple shampoo is how dry it makes their hair feel after they use it. I suggest mixing it with regular shampoo or their regular Shampoo to try and combat that. But what ingredients are in purple shampoo so specifically that make it so drying to everyone's hair? I love listening to your podcast. It's one of my favorite parts of my day. Keep doing what you're doing. It's great. Thank you.\"},{\"speaker\":\"A\",\"start\":2093.3,\"end\":2103.14,\"text\":\"Oh, thank you, Emma. We love that the show's the favorite part of your day. That makes me feel really good about how I felt last week where I was a little in the dumps about our reviews.\"},{\"speaker\":\"B\",\"start\":2103.22,\"end\":2106.18,\"text\":\"They love the chit chat, you know, so there you go.\"},{\"speaker\":\"A\",\"start\":2106.66,\"end\":2110.02,\"text\":\"Oh, wow. Well, we know a bit about purple shampoo.\"},{\"speaker\":\"B\",\"start\":2110.5,\"end\":2117.3,\"text\":\"Yeah, purple shampoo is the one that is used to make your gray hair kind of blend in and disappear.\"},{\"speaker\":\"A\",\"start\":2118.1,\"end\":2123.94,\"text\":\"Or if you have yellow hair from bleaching and you have this yellow pigment left, it helps neutralize it.\"},{\"speaker\":\"B\",\"start\":2124.02,\"end\":2131.3,\"text\":\"Yeah. So it just makes your hair look better. And it all features the dye. What is it? External DNC violet number two.\"},{\"speaker\":\"A\",\"start\":2131.3,\"end\":2134.74,\"text\":\"Is that also known as acid violet 43 in Europe?\"},{\"speaker\":\"B\",\"start\":2134.74,\"end\":2136.44,\"text\":\"Oh, there it is. There you go.\"},{\"speaker\":\"A\",\"start\":2136.44,\"end\":2138.52,\"text\":\"So I call it acid violet 43.\"},{\"speaker\":\"B\",\"start\":2139.72,\"end\":2143.32,\"text\":\"Well, I'm old school. External D and C violet number two.\"},{\"speaker\":\"A\",\"start\":2143.8,\"end\":2159.72,\"text\":\"Well, I can't. I can never remember if it gets, like, if it's just D and C, if the external has to be there, or if it's, you know, just D and C violet too. So I just say, you know what, call it by the acid dye name and you don't have to worry about that.\"},{\"speaker\":\"B\",\"start\":2159.88,\"end\":2171.2,\"text\":\"It's changed over the years. You know, when we were working with this, we, we, for some reason, you know, when we're working in the lab, because you use these dye powders at such tiny, tiny levels.\"},{\"speaker\":\"A\",\"start\":2171.2,\"end\":2173.08,\"text\":\"Very tiny levels. Very tiny.\"},{\"speaker\":\"B\",\"start\":2173.32,\"end\":2197.57,\"text\":\"You can't really measure the powder out. So to work with it in a lab, what you would do is make a solution of it. So most of them are water soluble and you could put it in. So you put in 10 grams, you make 100 grams of water. So you have a 10% solution. And that's easier to measure than the powders anyway. We did this with D and C violet too, but it wasn't completely water soluble.\"},{\"speaker\":\"A\",\"start\":2197.89,\"end\":2198.69,\"text\":\"No, it's not.\"},{\"speaker\":\"B\",\"start\":2199.81,\"end\":2210.21,\"text\":\"It's partially water soluble. So it kind of could work, but I don't know why we. I just remember the solution had like little globs floating on the top and you had to shake it before using it.\"},{\"speaker\":\"A\",\"start\":2210.29,\"end\":2251.45,\"text\":\"Well, I, I don't make solutions. I work on an analytical balance. Oh, okay. And I'm used to super teeny amounts. And then knowing, like, where the scale Cuts off for any kind of accuracy. And usually it's pretty good enough. But with purple shampoo, you're right, you're using very tiny amounts, which is crazy because when you get the purple shampoo, it looks so dark purple, hugely dark purple. And consumers are like, oh my gosh, there's so much color. Is this gonna turn my hair dark purple? And it's like there's literally like four decimal places of color in this. It's not going to do anything. So. Well, not that it won't do anything, but you know, it's a use over use type product. You don't have to worry about it turning your hair dark purple.\"},{\"speaker\":\"B\",\"start\":2252.25,\"end\":2269.29,\"text\":\"So as far as this drying piece goes, it is a little surprising to me that people report that it's drying because otherwise it's a regular shampoo. It just has this purple dye in it and it's in there at such a tiny amount. Why is this causing the dryness in hair?\"},{\"speaker\":\"A\",\"start\":2269.79,\"end\":2298.6,\"text\":\"Well, believe it or not, this purple shampoo dye, acid violet 43 is actually a bit negatively charged in character. So I wouldn't say it's in any ordinary shampoo. The shampoo can't really have conditioning agents in it because they would complex with this negatively charged dye. And so for this reason, any purple shampoo product tends to be really just a really great cleansing shampoo and doesn't.\"},{\"speaker\":\"B\",\"start\":2298.6,\"end\":2302.8,\"text\":\"Impart any moisturizing or conditioning.\"},{\"speaker\":\"A\",\"start\":2302.8,\"end\":2364.89,\"text\":\"Yeah, exactly, because it just, it really can't. Also, a purple shampoo now is so mainstream, you know, it has to have a really good price point. So they tend not to be really elaborate formulas. Also, you don't want these conditioning agents competing for the hair. You want the dye to be able to penetrate the hair. And so they're really just minimalist formulations. Also, I suspect because this dye sits on the surface of the hair, it can't really get in all the way. Consumers may be feeling some of this surface coating on the hair fiber, which may feel like the hair is dry, but it's actually just like this coating from the dye that you feel. So, multitude of factors, but essentially not a conditioning product because chemically it can't be. The formulas are pretty simple and you may be feeling the dye on the outside of the hair because this is ubiquitous across all purple shampoo brands. It's not just like one, it's like every single one. I've heard this complaint.\"},{\"speaker\":\"B\",\"start\":2365.21,\"end\":2405.07,\"text\":\"And the other thing to consider too is that people who are using these purple shampoos probably have already have dry hair. So it might just Be that your hair already is dry, but. And this shampoo is not doing anything to actually add moisturizing or conditioning to your hair. And so that could come off as, oh, it's a shampoo doing this. But it actually was your hair like that. Another piece that Emma said was that she had recommended that people mix things in with their shampoo to make it more conditioning. I. I'm not sure that that's such a great idea. Just use a conditioner afterwards.\"},{\"speaker\":\"A\",\"start\":2405.39,\"end\":2441.06,\"text\":\"Yeah, just use a conditioner afterwards. Because again, you don't want anything to interfere with that purple colorant because very little gets into the hair. Even if you use. As a chemist. If I were to put half a percent of this acid, violet 43 or external D\u0026C, violet 2 or violet number 2. See, I can't even remember if you were to put half a percent in. It doesn't really deposit a lot because it's such a huge molecule and it's negatively charged. So it's like an uphill battle to get it onto the hair. So if you just mix it with anything, you would actually be doing a disservice to what the shampoo could do.\"},{\"speaker\":\"B\",\"start\":2441.38,\"end\":2444.66,\"text\":\"Yeah, you're making the shampoo work worse. Mm.\"},{\"speaker\":\"A\",\"start\":2445.94,\"end\":2448.14,\"text\":\"Our next question comes to us from Mary Beth.\"},{\"speaker\":\"B\",\"start\":2448.14,\"end\":2448.62,\"text\":\"Hello.\"},{\"speaker\":\"A\",\"start\":2448.62,\"end\":2474.47,\"text\":\"I love your podcast. It is making me smarter about how much I believe the marketing hype around products for aging scale skin. Recently, I listened to a podcast with the founder of One Skin who talked about the discovery of the OS01 peptide, which magically reduces signs of aging skin. The products are very expensive. Have you looked into this brand? Are there other brands that have similar peptides that help aging skin? Thanks for sharing your knowledge with us. Best regards, Mary Beth in New York.\"},{\"speaker\":\"B\",\"start\":2475.51,\"end\":2499.9,\"text\":\"Oso One Peptide, One Skin again. Well, they must be doing a great job of marketing because it's generating a lot of questions. And in fact, we have talked about this a few times on episodes 344, 382 and 393. And what did we say about it, Valerie?\"},{\"speaker\":\"A\",\"start\":2501.26,\"end\":2520.16,\"text\":\"Well, we are sure they're great products and if you love the way they make you feel, then keep using them. But it's just very hard to have proof that peptides do anything, especially when any data comes from the brand. Right. You have to take it with a little bit of grain of salt when.\"},{\"speaker\":\"B\",\"start\":2520.16,\"end\":2576.51,\"text\":\"You have a small brand like Oneskin. And I'm sure the founder goes onto a podcast and they just say, ah, it's the best products. That's. What else are they gonna say? But when you're thinking of the technology and developing of skincare. The biggest breakthroughs are going to be coming from your big companies, your L', Oreals, your P\u0026G's, your Unilever's, because they spend the most money on R D. And if I would be more convinced by a peptide if this was from Olay for example, than it is from some startup brand who I don't know, they stumbled onto some technology that the big guys didn't find. I'm just skeptical. Call it that. And also it's hard to notice differences when you're using any anti aging ingredient because it's going to take what, six weeks before you see anything. If you're going to see anything. And who remembers what their skin looked like six weeks ago?\"},{\"speaker\":\"A\",\"start\":2576.83,\"end\":2589.25,\"text\":\"Well, my skin looks drastic from day and night, which is actually a thing. There's some research papers on this by the way. I have one on my desktop right now. Well, you know, just because you're your day can really influence the way your skin looks.\"},{\"speaker\":\"B\",\"start\":2589.41,\"end\":2589.81,\"text\":\"Sure.\"},{\"speaker\":\"A\",\"start\":2589.89,\"end\":2606.61,\"text\":\"Especially at the end of it. Well, I thought, Perry, we could throw in a bonus question here because we have covered this topic in the past on the OS01 peptide and the One Skin brand. So here we have an alternate question. And guess what? You're going to be so happy with this.\"},{\"speaker\":\"B\",\"start\":2607.01,\"end\":2617.03,\"text\":\"I am. This person actually specifically requested that we do an AI voice and make it an Australian man. So let's do that now.\"},{\"speaker\":\"D\",\"start\":2617.43,\"end\":2642.57,\"text\":\"Hi Beauty Brains. I've been tempted by TikTok ads for a new barrier strengthening moisturizer from Experiment Beauty called Molecular Mesh. They rely heavily on videos from their cosmetic chemists to explain the special ingredients of the product. They especially highlight ectoin, phytosohenosine, glycerin, centella, liposomes and and Guaya zuleen. Thoughts? Thanks.\"},{\"speaker\":\"B\",\"start\":2643.13,\"end\":2648.41,\"text\":\"All right. Have you heard of this brand Experiment with the special molecular mesh?\"},{\"speaker\":\"A\",\"start\":2648.89,\"end\":2654.89,\"text\":\"I actually have heard of them and this is a very popular product right now. And for good reason.\"},{\"speaker\":\"B\",\"start\":2655.29,\"end\":2655.85,\"text\":\"I see.\"},{\"speaker\":\"A\",\"start\":2656.25,\"end\":2726.57,\"text\":\"$51\"},{\"speaker\":\"B\",\"start\":2727.13,\"end\":2731.45,\"text\":\"So liposomes, ceramides, and amino acids.\"},{\"speaker\":\"A\",\"start\":2732.57,\"end\":2738.33,\"text\":\"Well, ectoin, they call it an amino acid, but it's not really an amino acid. Are you familiar with it?\"},{\"speaker\":\"B\",\"start\":2738.81,\"end\":2749.79,\"text\":\"Yeah, yeah. It's like. It's definitely not one of the 20amino acids that make up the proteins in human bodies, but I think it's some sort of derivative of amino acids. So it has the.\"},{\"speaker\":\"A\",\"start\":2750.11,\"end\":2799.44,\"text\":\"It has the carboxylic acid group, it has the amine group. So it has a similar structure, and they call it an amino acid. But that's actually a really great material. My favorite serum that I've been using this last year is actually an ectoin serum prototype from an ectoin supplier. So, yeah, I've been really impressed with this, with this molecule. But, yeah, just a really nice moisturizer. They have a lot of oils, like capryllo, capric triglyceride, safflower seed oil, and then they have a bunch of humectants, emollients, in it to make it feel really luxurious on skin. And then just, you know, with ceramides, you actually don't need a lot. They impart a really big oomph on skin. I'm talking, like, less than 0.1% in a formula. You would feel the impact of a ceramide.\"},{\"speaker\":\"B\",\"start\":2799.76,\"end\":2810.92,\"text\":\"It is interesting that she says that they rely heavily on their videos of their cosmetic chemists to explain their special ingredients. I mean, that's a marketing strategy, I guess.\"},{\"speaker\":\"A\",\"start\":2811.88,\"end\":2823.72,\"text\":\"Yeah, everyone likes to see that there's some brains behind the operation. So I think that's a really nice strategy that they've employed. But, you know, I don't think they need that. I think they have some great stuff.\"},{\"speaker\":\"B\",\"start\":2823.88,\"end\":2854.52,\"text\":\"Well, if you're going for, like, a sciencey story, which is what they're going for here, I could see that, that angle. It, you know, whenever you put, like, a lab coat on somebody, it makes what they're saying seem more legitimate, even if it's just marketing gobbledygook. But because the molecular mesh. What is. What is this? That's like, not science. That's just a marketing term. Well, looking at their founders, it does look like they do have chemistry backgrounds.\"},{\"speaker\":\"A\",\"start\":2855.24,\"end\":2866.71,\"text\":\"Yeah. I think one of them has worked in the industry a little bit. So that's kind of cool to see that there is a bit of real knowledge going into the product. Sometimes it's just like a. Well, you know, sometimes it's like a cover story, right?\"},{\"speaker\":\"B\",\"start\":2866.71,\"end\":2868.31,\"text\":\"Well, yeah, exactly.\"},{\"speaker\":\"A\",\"start\":2868.95,\"end\":2870.55,\"text\":\"This doesn't feel like a cover story.\"},{\"speaker\":\"B\",\"start\":2870.87,\"end\":2906.24,\"text\":\"Well, it's a huge challenge, in my opinion, for scientists to launch beauty products because so much of a beauty product success is based on the marketing and the marketing story that you can tell. And honestly, you kind of have to believe some BS to be able to, like, talk confidently. You get you to. When you're a scientist, you kind of have to be skeptical of things that you hear and read. And you're like, oh, this does that. And you're like, does it really? And while that makes for good science, it does not make for good selling and marketing. So that's what the big challenge is.\"},{\"speaker\":\"A\",\"start\":2906.4,\"end\":2931.53,\"text\":\"Exactly. Well, that's why I think they have done so well is because they have two co founders. One is more in the lab base and the other has a chemistry degree. But I don't think that they've worked on the chemistry side of our industry. So I think more of a beauty aficionado. So you have that person who can provide that hope in the bottle. But, yeah, it looks very fun and they're doing very well. And I'm sure it's a really great moisturizer.\"},{\"speaker\":\"B\",\"start\":2931.85,\"end\":2936.37,\"text\":\"Yeah. Well, those are our thoughts. And looks like we got time for.\"},{\"speaker\":\"A\",\"start\":2936.37,\"end\":2938.81,\"text\":\"One more comes to us from Jillian.\"},{\"speaker\":\"B\",\"start\":2939.13,\"end\":2978.33,\"text\":\"Jillian says this is for Valerie. Hello, and thank you so much for your wonderful podcast. I'm a new listener and soon to be Patreon supporter. Regarding the topic of rosacea, I did try scanning through the years of episodes to find ones, but no avail. How do you deal with rosacea? I'm contacting you specifically, Valerie, with this question because on a recent episode, I heard you mention that you deal with rosacea. And I'd like to pass on professional info on this topic to my stepson's girlfriend who deals with the condition. Thank you for your attention to my question. Oh, my God. Thank you for your attention this matter. Thanks so much, Jillian.\"},{\"speaker\":\"A\",\"start\":2980.65,\"end\":2986.61,\"text\":\"Well, we have talked about it before, but you're right. I guess it would be kind of hard to find because it's Right.\"},{\"speaker\":\"B\",\"start\":2986.61,\"end\":2986.85,\"text\":\"Right.\"},{\"speaker\":\"A\",\"start\":2986.85,\"end\":2987.45,\"text\":\"We don't.\"},{\"speaker\":\"B\",\"start\":2987.45,\"end\":2992.73,\"text\":\"We don't index our podcasts very well yet. Maybe we'll get some AI.\"},{\"speaker\":\"A\",\"start\":2992.81,\"end\":3019.23,\"text\":\"We should. Yeah. So I do struggle with rosacea. And actually when I was pregnant, which none of you guys knew about because I kept it a secret from everyone, even in the industry, I actually, for the first trimester and a half, suffered horribly from. I have pustular rosacea. And I just looked, like, horrible the whole time. It was a huge breakout all over my cheeks.\"},{\"speaker\":\"B\",\"start\":3019.23,\"end\":3020.35,\"text\":\"You didn't look horrible.\"},{\"speaker\":\"A\",\"start\":3020.51,\"end\":3022.03,\"text\":\"My nose, which is where I get it.\"},{\"speaker\":\"B\",\"start\":3022.56,\"end\":3023.12,\"text\":\"Yeah, I didn't.\"},{\"speaker\":\"A\",\"start\":3023.12,\"end\":3164.71,\"text\":\"$52\"},{\"speaker\":\"B\",\"start\":3165.11,\"end\":3189.96,\"text\":\"Yeah. The other things that are topical are anti inflammatories, you know, and not everything works for everyone. So an anti inflammatory, a topical might not work for somebody. So then they. There's oral medications that you get. But again, you know, we're not doctors, so I'm not gonna suggest any medication specifically. You go to a doctor. But those are the kinds of things that the doctor will suggest.\"},{\"speaker\":\"A\",\"start\":3190.76,\"end\":3195.64,\"text\":\"Exactly. So, Jillian, hopefully that helps your stepson's girlfriend. And thank you for your compliments on the show.\"},{\"speaker\":\"B\",\"start\":3196.76,\"end\":3199,\"text\":\"Speaking of show, do you hear that music?\"},{\"speaker\":\"A\",\"start\":3199.56,\"end\":3203.88,\"text\":\"I hear thunder, and that means I have to go before our Internet cuts out.\"},{\"speaker\":\"B\",\"start\":3203.88,\"end\":3208.92,\"text\":\"Wait, did. Did we change the music? The thunder and the lightning.\"},{\"speaker\":\"A\",\"start\":3209.24,\"end\":3218.29,\"text\":\"Oh, I hate that song. I was hoping you could put Thunderstruck on it, but we might get in trouble. But maybe not, because we actually don't generate ad revenue from this podcast.\"},{\"speaker\":\"B\",\"start\":3218.61,\"end\":3223.89,\"text\":\"Right, exactly. So YouTube will flag the ads and then nobody will get anything in it.\"},{\"speaker\":\"A\",\"start\":3223.89,\"end\":3233.25,\"text\":\"Do you think you could make AI version of Thunderstruck but for our show and so we don't get in trouble because that's the Dallas Cowboys cheerleader song.\"},{\"speaker\":\"B\",\"start\":3233.33,\"end\":3239.34,\"text\":\"Oh, is it? Wow, that's fun. Well, we'll see what happens. Wait till the end. End of the show and you might see it.\"},{\"speaker\":\"A\",\"start\":3239.34,\"end\":3246.62,\"text\":\"Oh, my gosh. Thanks for listening, everyone. If you get a chance, head over to Apple Podcasts or Spotify and leave us a review that's going to help other people Positive.\"},{\"speaker\":\"B\",\"start\":3246.62,\"end\":3248.94,\"text\":\"Find the show that we want Valerie to feel good.\"},{\"speaker\":\"A\",\"start\":3249.82,\"end\":3258.7,\"text\":\"Help my self esteem. I'm. I have postpartum stuff. I need an esteem boost that's going to help other people find the show and ensure we have a full docket of beauty questions to answer.\"},{\"speaker\":\"B\",\"start\":3259.1,\"end\":3280.469,\"text\":\"Speaking of questions, if you have a question, just record it on your smartphone and email it to the Beautybrains and you can get on the show with your voice. Or if you like the AI voices, just let us know what AI accent you want and we can put that on too. Or you can also use the form in the show notes of this episode.\"},{\"speaker\":\"A\",\"start\":3281.35,\"end\":3284.31,\"text\":\"Or our 1, 800 number. Has anyone else done that yet?\"},{\"speaker\":\"B\",\"start\":3284.95,\"end\":3295.37,\"text\":\"I have gotten some 1, 800 numbers. You can leave a voicemail with our number 872-216-1856.\"},{\"speaker\":\"A\",\"start\":3296.33,\"end\":3299.69,\"text\":\"Is this a number? I can also get a hold of you at if I need to tell you something.\"},{\"speaker\":\"B\",\"start\":3300.73,\"end\":3305.37,\"text\":\"No, I do not answer it, but if you do still leave a message, Yes, I will. I will see it.\"},{\"speaker\":\"A\",\"start\":3306.009,\"end\":3332.9,\"text\":\"The Beauty Brains are also on Patreon. You might have heard over the show we mentioned some of our listeners are patrons. This show is ad free. We do not have pesky ads. We are not corporate shills. And so we have to fund the show somehow. So we have a Patreon account and essentially the show is supported by our listeners like you. If you'd like to support the show at any level, you can head over to patreon.com forward/thebeautybrains and subscribe.\"},{\"speaker\":\"B\",\"start\":3333.46,\"end\":3342.39,\"text\":\"And you also get a transcript of the show. You get your questions a higher priority and on occasion we will do patronage only events.\"},{\"speaker\":\"A\",\"start\":3343.51,\"end\":3357.11,\"text\":\"Don't forget to follow us on our various social media accounts on Instagram where at the Beautybrains 2018 on X worth the Beauty Brains on Blue sky, we're at the Beauty Brains. We have a Facebook page, a TikTok and a YouTube channel at the BeautyBrains 2018.\"},{\"speaker\":\"B\",\"start\":3357.75,\"end\":3368.17,\"text\":\"Yeah, you can just listen to us on YouTube if you like to listen that way. And someday we might even show a little recording from our face to face here.\"},{\"speaker\":\"A\",\"start\":3368.89,\"end\":3370.57,\"text\":\"But not today because I look terrible.\"},{\"speaker\":\"B\",\"start\":3371.53,\"end\":3372.89,\"text\":\"Oh come on, you look great.\"},{\"speaker\":\"A\",\"start\":3373.29,\"end\":3377.37,\"text\":\"Thanks again for listening everyone. And remember, be brainy about your beauty.\"},{\"speaker\":\"B\",\"start\":3378.25,\"end\":3385.61,\"text\":\"Thanks everyone. Kittens.\"}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"53:I[63625,[\"/_next/static/chunks/3xnt26d00_zk-.js\",\"/_next/static/chunks/1jlysr8cp4pm9.js\",\"/_next/static/chunks/42spz6paskvb6.js\",\"/_next/static/chunks/06x30xgfe6iur.js\",\"/_next/static/chunks/1zu2-5qk7iyix.js\",\"/_next/static/chunks/4484p5ab64syg.js\"],\"AddToLibraryButton\"]\n54:I[29721,[\"/_next/static/chunks/3xnt26d00_zk-.js\",\"/_next/static/chunks/1jlysr8cp4pm9.js\",\"/_next/static/chunks/42spz6paskvb6.js\",\"/_next/static/chunks/06x30xgfe6iur.js\",\"/_next/static/chunks/1zu2-5qk7iyix.js\",\"/_next/static/chunks/4484p5ab64syg.js\"],\"ShareButton\"]\n55:I[58016,[\"/_next/static/chunks/3xnt26d00_zk-.js\",\"/_next/static/chunks/1jlysr8cp4pm9.js\",\"/_next/static/chunks/42spz6paskvb6.js\",\"/_next/static/chunks/06x30xgfe6iur.js\",\"/_next/static/chunks/1zu2-5qk7iyix.js\",\"/_next/static/chunks/4484p5ab64syg.js\"],\"ProcessEpisodeButton\"]\n48:[\"$\",\"$L53\",null,{\"seriesUuid\":\"b6877353-cd94-415f-91b1-16c1b6b62991\",\"size\":\"md\"}]\n49:[\"$\",\"$L54\",null,{\"title\":\"Can Collagen really improve skin \u0026 why is purple shampoo drying? - episode 406\",\"url\":\"https://pod.wave.co/podcast/the-beauty-brains/can-collagen-really-improve-skin-why-is-purple-shampoo-drying-episode-406\"}]\n4a:[\"$\",\"$L55\",null,{\"episodeData\":\"$3e:props:children:0:props:episodeData\"}]\n"])</script><link rel="preload" href="https://storage.buzzsprout.com/bcflyq376wo0n1pk8h1tsvm3vk3s?.jpg" as="image"/><title>Can Collagen really improve skin &amp; why is purple shampoo drying? - episode 406 - The Beauty Brains | Wave AI Podcast Notes</title><meta name="description" content="Send us Fan MailOn this show we cover lots of questions including…How can you tell if a new product is just a name change or the formulas are different?Why can’"/><link rel="author" href="https://wave.co"/><meta name="author" content
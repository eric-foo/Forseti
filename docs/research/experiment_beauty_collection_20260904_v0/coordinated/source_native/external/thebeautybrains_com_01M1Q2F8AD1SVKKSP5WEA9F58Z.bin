roximate timestamps0:00 - Intro1:00 - Chit chat5:45 - Beauty news - Collagen supplem\",\"image\":\"https://storage.buzzsprout.com/bcflyq376wo0n1pk8h1tsvm3vk3s?.jpg\",\"url\":\"https://pod.wave.co/podcast/the-beauty-brains/can-collagen-really-improve-skin-why-is-purple-shampoo-drying-episode-406\",\"partOfSeries\":{\"@type\":\"PodcastSeries\",\"name\":\"The Beauty Brains\",\"url\":\"https://pod.wave.co/podcast/the-beauty-brains\"},\"provider\":{\"@type\":\"Organization\",\"name\":\"Wave AI Podcast Notes\",\"url\":\"https://pod.wave.co\"},\"datePublished\":\"2025-09-08T13:00:00.000Z\",\"timeRequired\":\"PT56M27S\"}"])</script><script>self.__next_f.push([1,"22:[\"$\",\"div\",null,{\"className\":\"bg-[color:var(--bg-1)]\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$39\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://pod.wave.co\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"The Beauty Brains\\\",\\\"item\\\":\\\"https://pod.wave.co/podcast/the-beauty-brains\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Can Collagen really improve skin \u0026 why is purple shampoo drying? - episode 406\\\"}]}\"}}],[\"$\",\"header\",null,{\"className\":\"border-b border-[color:var(--border-2)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-editorial px-6 pt-10 pb-12 md:px-8 md:pt-14\",\"children\":[[\"$\",\"$L1b\",null,{\"href\":\"/podcast/the-beauty-brains\",\"className\":\"inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-[color:var(--fg-3)] transition-colors hover:text-[color:var(--accent)]\",\"children\":[\"← \",\"The Beauty Brains\"]}],[\"$\",\"div